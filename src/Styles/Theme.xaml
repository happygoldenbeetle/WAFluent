<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhatsAppNative.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ChatPaneBackgroundBrush" Color="#EFEAE2" />
            <SolidColorBrush x:Key="ChatHeaderBackgroundBrush" Color="#F9F9F9" />
            <SolidColorBrush x:Key="PaneDividerBrush" Color="#14000000" />
            <SolidColorBrush x:Key="OutgoingBubbleBrush" Color="#D9FDD3" />
            <SolidColorBrush x:Key="IncomingBubbleBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BubbleShadowBrush" Color="#1A0B141A" />
            <SolidColorBrush x:Key="BubbleTextBrush" Color="#111B21" />
            <SolidColorBrush x:Key="MetaTextBrush" Color="#667781" />
            <SolidColorBrush x:Key="SentTickBrush" Color="#8696A0" />
            <SolidColorBrush x:Key="ReadTickBrush" Color="#2F9AE0" />
            <SolidColorBrush x:Key="FileCardBrush" Color="#0D0B141A" />
            <SolidColorBrush x:Key="BubbleButtonBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BubbleButtonBorderBrush" Color="#140B141A" />
            <SolidColorBrush x:Key="ComposerBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DatePillBrush" Color="#FFFFFF" />
            <ImageBrush x:Key="WallpaperBrush" ImageSource="ms-appx:///Assets/Wallpaper.Light.png" Stretch="None" AlignmentX="Left" AlignmentY="Top" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ChatPaneBackgroundBrush" Color="#111518" />
            <SolidColorBrush x:Key="ChatHeaderBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="PaneDividerBrush" Color="#33000000" />
            <SolidColorBrush x:Key="OutgoingBubbleBrush" Color="#005C4B" />
            <SolidColorBrush x:Key="IncomingBubbleBrush" Color="#202C33" />
            <SolidColorBrush x:Key="BubbleShadowBrush" Color="#40000000" />
            <SolidColorBrush x:Key="BubbleTextBrush" Color="#E9EDEF" />
            <SolidColorBrush x:Key="MetaTextBrush" Color="#9DAAB2" />
            <SolidColorBrush x:Key="SentTickBrush" Color="#9DAAB2" />
            <SolidColorBrush x:Key="ReadTickBrush" Color="#53BDEB" />
            <SolidColorBrush x:Key="FileCardBrush" Color="#26000000" />
            <SolidColorBrush x:Key="BubbleButtonBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="BubbleButtonBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ComposerBrush" Color="#2A2F32" />
            <SolidColorBrush x:Key="DatePillBrush" Color="#182229" />
            <ImageBrush x:Key="WallpaperBrush" ImageSource="ms-appx:///Assets/Wallpaper.Dark.png" Stretch="None" AlignmentX="Left" AlignmentY="Top" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ChatPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChatHeaderBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PaneDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OutgoingBubbleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IncomingBubbleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BubbleShadowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BubbleTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MetaTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SentTickBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ReadTickBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FileCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BubbleButtonBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="BubbleButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="ComposerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DatePillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <ImageBrush x:Key="WallpaperBrush" ImageSource="ms-appx:///Assets/Wallpaper.Dark.png" Stretch="None" AlignmentX="Left" AlignmentY="Top" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Borderless icon button with the standard hover/pressed fill. -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="BubbleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource BubbleButtonBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BubbleButtonBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="32" />
    </Style>

    <Style TargetType="controls:Bubble">
        <Setter Property="Padding" Value="9,6,9,6" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Bubble">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Direction">
                                <VisualState x:Name="Incoming" />
                                <VisualState x:Name="Outgoing">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource OutgoingBubbleBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Chrome"
                                Background="{ThemeResource IncomingBubbleBrush}"
                                BorderBrush="{ThemeResource BubbleShadowBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              Foreground="{ThemeResource BubbleTextBrush}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource MetaTextBrush}" />
    </Style>
</ResourceDictionary>
