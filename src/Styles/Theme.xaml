<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhatsAppNative.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ChatPaneBackgroundBrush" Color="#F0EFED" />
            <!-- WhatsApp green for pings and chat content (badges, unread times, sender names...);
                 stays green with "Use Windows accent colour", which only recolours controls. -->
            <SolidColorBrush x:Key="ChatAccentBrush" Color="#008069" />
            <SolidColorBrush x:Key="ChatAccentTextBrush" Color="#017561" />
            <!-- Block / Clear / Delete: bright red. -->
            <SolidColorBrush x:Key="DangerBrush" Color="#E81123" />
            <SolidColorBrush x:Key="LightboxBackgroundBrush" Color="#F5F5F5F5" />
            <SolidColorBrush x:Key="LightboxBarBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="VoiceRateBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="ChatHeaderBackgroundBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="PaneDividerBrush" Color="#14000000" />
            <SolidColorBrush x:Key="OutgoingBubbleBrush" Color="#D9FDD3" />
            <SolidColorBrush x:Key="IncomingBubbleBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BubbleShadowBrush" Color="#1A0B141A" />
            <SolidColorBrush x:Key="BubbleTextBrush" Color="#111B21" />
            <SolidColorBrush x:Key="MetaTextBrush" Color="#667781" />
            <SolidColorBrush x:Key="SentTickBrush" Color="#8696A0" />
            <SolidColorBrush x:Key="ReadTickBrush" Color="#2F9AE0" />
            <SolidColorBrush x:Key="FileCardBrush" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="FileCardDividerBrush" Color="#140B141A" />
            <SolidColorBrush x:Key="BubbleButtonBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="BubbleButtonBorderBrush" Color="#00000000" />
            <SolidColorBrush x:Key="ComposerBrush" Color="#FAFAFA" />
            <SolidColorBrush x:Key="DatePillBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="QuoteBrush" Color="#0D0B141A" />
            <SolidColorBrush x:Key="QuoteOtherBrush" Color="#6B4EAB" />
            <SolidColorBrush x:Key="QuoteSelfBrush" Color="#008069" />
            <!-- WhatsApp's classic doodle tile (beige, drawn in). -->
            <SolidColorBrush x:Key="WallpaperColorBrush" Color="#E5DDD5" />
            <BitmapImage x:Key="WallpaperTile" UriSource="ms-appx:///Assets/Wallpaper.Light.png" />
            <x:Double x:Key="WallpaperTileOpacity">1</x:Double>
            <x:Double x:Key="WallpaperTileWidth">412.5</x:Double>
            <x:Double x:Key="WallpaperTileHeight">757.7</x:Double>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ChatPaneBackgroundBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="ChatAccentBrush" Color="#25D366" />
            <SolidColorBrush x:Key="ChatAccentTextBrush" Color="#21C063" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF3B3B" />
            <SolidColorBrush x:Key="LightboxBackgroundBrush" Color="#F20F0F0F" />
            <SolidColorBrush x:Key="LightboxBarBrush" Color="#CC202020" />
            <SolidColorBrush x:Key="VoiceRateBrush" Color="#99000000" />
            <SolidColorBrush x:Key="ChatHeaderBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="PaneDividerBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="OutgoingBubbleBrush" Color="#144D37" />
            <SolidColorBrush x:Key="IncomingBubbleBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="BubbleShadowBrush" Color="#40000000" />
            <SolidColorBrush x:Key="BubbleTextBrush" Color="#F2F2F2" />
            <SolidColorBrush x:Key="MetaTextBrush" Color="#A8A8A8" />
            <SolidColorBrush x:Key="SentTickBrush" Color="#A8A8A8" />
            <SolidColorBrush x:Key="ReadTickBrush" Color="#53BDEB" />
            <SolidColorBrush x:Key="FileCardBrush" Color="#26000000" />
            <SolidColorBrush x:Key="FileCardDividerBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="BubbleButtonBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="BubbleButtonBorderBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="ComposerBrush" Color="#202020" />
            <SolidColorBrush x:Key="DatePillBrush" Color="#00000000" />
            <SolidColorBrush x:Key="QuoteBrush" Color="#26000000" />
            <SolidColorBrush x:Key="QuoteOtherBrush" Color="#A791FF" />
            <SolidColorBrush x:Key="QuoteSelfBrush" Color="#06CF9C" />
            <!-- White doodles, faint over WhatsApp's dark green-grey. -->
            <SolidColorBrush x:Key="WallpaperColorBrush" Color="#0B141A" />
            <BitmapImage x:Key="WallpaperTile" UriSource="ms-appx:///Assets/Wallpaper.Dark.png" />
            <x:Double x:Key="WallpaperTileOpacity">0.06</x:Double>
            <x:Double x:Key="WallpaperTileWidth">412.5</x:Double>
            <x:Double x:Key="WallpaperTileHeight">749.4</x:Double>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ChatPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChatAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChatAccentTextBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="LightboxBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LightboxBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="VoiceRateBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ChatHeaderBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PaneDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OutgoingBubbleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IncomingBubbleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BubbleShadowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BubbleTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="MetaTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SentTickBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ReadTickBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FileCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FileCardDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BubbleButtonBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="BubbleButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="ComposerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DatePillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="QuoteBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="QuoteOtherBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="QuoteSelfBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="WallpaperColorBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <BitmapImage x:Key="WallpaperTile" UriSource="ms-appx:///Assets/Wallpaper.Dark.png" />
            <x:Double x:Key="WallpaperTileOpacity">0</x:Double>
            <x:Double x:Key="WallpaperTileWidth">412.5</x:Double>
            <x:Double x:Key="WallpaperTileHeight">749.4</x:Double>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Borderless icon button with the standard hover/pressed fill. -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="BubbleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource BubbleButtonBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BubbleButtonBorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="32" />
    </Style>

    <Style TargetType="controls:Bubble">
        <Setter Property="Padding" Value="9,6,9,6" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Bubble">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="Direction">
                                <VisualState x:Name="Incoming" />
                                <VisualState x:Name="Outgoing">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource OutgoingBubbleBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Chrome"
                                Background="{ThemeResource IncomingBubbleBrush}"
                                BorderBrush="{ThemeResource BubbleShadowBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="Stretch"
                                              Foreground="{ThemeResource BubbleTextBrush}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Emoji reaction that overlaps the bottom edge of a bubble. -->
    <Style x:Key="ReactionPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource IncomingBubbleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BubbleShadowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="5,1,5,2" />
        <Setter Property="Margin" Value="8,-6,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Numbered circle on the link screen. -->
    <Style x:Key="StepNumberStyle" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Round buttons in the call window. -->
    <Style x:Key="CallButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="CallToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="MetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource MetaTextBrush}" />
    </Style>
</ResourceDictionary>
