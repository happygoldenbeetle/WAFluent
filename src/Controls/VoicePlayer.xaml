<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WhatsAppNative.Controls.VoicePlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhatsAppNative.Controls"
    IsTabStop="False">

    <!--
      [▶] [•··waveform···]  (picture🎤)     idle: the sender's picture with a mic badge
      0:19                     2:59 ✓✓      duration under the play icon, time under the picture
      [❚❚] [····•······]    [1.5×]          playing: the speed pill in the picture's place

      Spacing is tuned by eye: the meta line is light text, so the gap under it is a touch
      smaller than the gap above the (solid) picture, which reads as equal.
    -->
    <Grid Width="320" Margin="0,6,0,6" RowSpacing="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Theme-aware bar colours, read from these hidden shapes (ThemeResource updates them). -->
        <Rectangle x:Name="PlayedSwatch" Visibility="Collapsed" Fill="{ThemeResource VoicePlayedBrush}" />
        <Rectangle x:Name="UnplayedSwatch" Visibility="Collapsed" Fill="{ThemeResource MetaTextBrush}" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Filled play / pause with softened corners, like WhatsApp. -->
            <Grid Width="36" Height="36" VerticalAlignment="Center">
                <Button x:Name="PlayButton" Width="36" Height="36" Padding="0" CornerRadius="18" BorderThickness="0"
                        Background="Transparent" Click="Play_Click" AutomationProperties.Name="Play voice message">
                    <Grid Width="14" Height="16">
                        <PathIcon x:Name="PlayIcon" Data="M0,1.6 Q0,0 1.39,0.79 L12.61,7.21 Q14,8 12.61,8.79 L1.39,15.21 Q0,16 0,14.4 Z" Margin="1,0,-1,0" />
                        <PathIcon x:Name="PauseIcon" Visibility="Collapsed"
                                  Data="M0,1.5 Q0,0 1.5,0 H3 Q4.5,0 4.5,1.5 V14.5 Q4.5,16 3,16 H1.5 Q0,16 0,14.5 Z M9.5,1.5 Q9.5,0 11,0 H12.5 Q14,0 14,1.5 V14.5 Q14,16 12.5,16 H11 Q9.5,16 9.5,14.5 Z" />
                        <FontIcon x:Name="WarningIcon" Glyph="&#xE7BA;" FontSize="18" Visibility="Collapsed" Margin="-2" />
                    </Grid>
                </Button>
                <ProgressRing x:Name="LoadingRing" Width="30" Height="30" IsHitTestVisible="False" />
            </Grid>

            <!-- Waveform: click or drag the dot to move through the note. Transparent background so the
                 gaps between bars respond too. -->
            <Grid x:Name="Wave" Grid.Column="1" Height="32" VerticalAlignment="Center" Background="Transparent"
                  PointerPressed="Wave_PointerPressed" PointerMoved="Wave_PointerMoved"
                  PointerReleased="Wave_PointerReleased" PointerCaptureLost="Wave_PointerCaptureLost">
                <StackPanel x:Name="Bars" Orientation="Horizontal" Spacing="1.5" VerticalAlignment="Center" />
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="Knob" Width="13" Height="13" Canvas.Top="9.5" Fill="{ThemeResource VoiceKnobBrush}" />
                </Canvas>
            </Grid>

            <!-- Idle: who sent it (mic badge), or headphones for an audio file. Playing: the speed. -->
            <Grid Grid.Column="2" Width="52" Height="52" VerticalAlignment="Center">
                <Grid x:Name="PictureArea">
                    <controls:Redact VeilRadius="26">
                        <controls:Avatar x:Name="Picture" Size="52" />
                    </controls:Redact>
                    <Border x:Name="Headphones" CornerRadius="26" Background="{ThemeResource VoiceHeadphonesBrush}" Visibility="Collapsed">
                        <FontIcon Glyph="&#xE7F6;" FontSize="22" Foreground="White" />
                    </Border>
                    <!-- Filled mic. -->
                    <PathIcon x:Name="MicBadge" Foreground="{ThemeResource VoiceKnobBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,-1"
                              Data="M6,0 A2.5,2.5 0 0 1 8.5,2.5 V7.5 A2.5,2.5 0 0 1 3.5,7.5 V2.5 A2.5,2.5 0 0 1 6,0 Z M0.6,6.3 H1.9 A4.1,4.1 0 0 0 10.1,6.3 H11.4 A5.4,5.4 0 0 1 6.65,11.66 V14 H8.6 V15.4 H3.4 V14 H5.35 V11.66 A5.4,5.4 0 0 1 0.6,6.3 Z" />
                </Grid>
                <Button x:Name="RateButton" Width="46" Height="26" Padding="0" CornerRadius="13" BorderThickness="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Background="{ThemeResource VoiceRateBrush}" Visibility="Collapsed"
                        Click="Rate_Click" AutomationProperties.Name="Playback speed">
                    <!-- Tight bounds: the box is exactly the glyphs, so centring is exact. -->
                    <TextBlock x:Name="RateText" FontSize="12" FontWeight="SemiBold" TextLineBounds="Tight"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Grid>

        <!-- Duration starts under the play icon's left edge; time and ticks end under the picture's right edge. -->
        <Grid Grid.Row="1">
            <TextBlock x:Name="DurationText" Style="{StaticResource MetaTextStyle}" TextLineBounds="Tight" Margin="11,0,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="3">
                <TextBlock x:Name="TimeText" Style="{StaticResource MetaTextStyle}" TextLineBounds="Tight" VerticalAlignment="Bottom" />
                <controls:DeliveryTicks x:Name="Ticks" VerticalAlignment="Bottom" Margin="0,0,0,-2" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
