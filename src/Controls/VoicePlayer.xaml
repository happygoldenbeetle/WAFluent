<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WhatsAppNative.Controls.VoicePlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhatsAppNative.Controls"
    IsTabStop="False">

    <Grid Width="280" ColumnSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Theme-aware bar colours, read from these hidden shapes (ThemeResource updates them). -->
        <Rectangle x:Name="PlayedSwatch" Visibility="Collapsed" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        <Rectangle x:Name="UnplayedSwatch" Visibility="Collapsed" Fill="{ThemeResource MetaTextBrush}" />

        <Grid Width="40" Height="40" VerticalAlignment="Center">
            <Button x:Name="PlayButton" Width="40" Height="40" Padding="0" CornerRadius="20" BorderThickness="0"
                    Background="Transparent" Click="Play_Click"
                    AutomationProperties.Name="Play voice message">
                <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="18" />
            </Button>
            <ProgressRing x:Name="LoadingRing" Width="28" Height="28" IsHitTestVisible="False" />
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Waveform: tap to seek. Transparent background so the gaps are clickable too. -->
            <StackPanel x:Name="Bars" Orientation="Horizontal" Spacing="1.5" VerticalAlignment="Center"
                        Background="Transparent" Tapped="Bars_Tapped" />

            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="DurationText" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                    <Button x:Name="RateButton" Padding="5,0" MinHeight="0" Height="18" CornerRadius="9" FontSize="10"
                            BorderThickness="0" Visibility="Collapsed" Click="Rate_Click"
                            AutomationProperties.Name="Playback speed" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="3">
                    <TextBlock x:Name="TimeText" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                    <controls:DeliveryTicks x:Name="Ticks" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
