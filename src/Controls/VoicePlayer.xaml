<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WhatsAppNative.Controls.VoicePlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhatsAppNative.Controls"
    IsTabStop="False">

    <!--
      [▶] [waveform ···•···] [1×]      ← centred: equal bands above and below
          0:07              18:02 ✓✓   ← meta line lives in the bottom band
    -->
    <Grid Width="300">
        <!-- Theme-aware bar colours, read from these hidden shapes (ThemeResource updates them). -->
        <Rectangle x:Name="PlayedSwatch" Visibility="Collapsed" Fill="{ThemeResource ChatAccentBrush}" />
        <Rectangle x:Name="UnplayedSwatch" Visibility="Collapsed" Fill="{ThemeResource MetaTextBrush}" />

        <Grid Margin="0,16" ColumnSpacing="10" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="40" Height="40">
                <Button x:Name="PlayButton" Width="40" Height="40" Padding="0" CornerRadius="20" BorderThickness="0"
                        Background="Transparent" Click="Play_Click"
                        AutomationProperties.Name="Play voice message">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="18" />
                </Button>
                <ProgressRing x:Name="LoadingRing" Width="28" Height="28" IsHitTestVisible="False" />
            </Grid>

            <!-- Waveform: tap to seek. Transparent background so the gaps are clickable too. -->
            <Grid Grid.Column="1" Height="32" VerticalAlignment="Center">
                <StackPanel x:Name="Bars" Orientation="Horizontal" Spacing="1.5" VerticalAlignment="Center"
                            Background="Transparent" Tapped="Bars_Tapped" />
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="Knob" Width="12" Height="12" Canvas.Top="10" Visibility="Collapsed"
                             Fill="{ThemeResource ChatAccentBrush}" />
                </Canvas>
            </Grid>

            <!-- Keeps its space while hidden, so the waveform doesn't shift when playback starts. -->
            <Button x:Name="RateButton" Grid.Column="2" Width="38" Height="22" Padding="0" CornerRadius="11"
                    FontSize="11" FontWeight="SemiBold" BorderThickness="0" VerticalAlignment="Center"
                    Background="{ThemeResource VoiceRateBrush}" Opacity="0" IsHitTestVisible="False"
                    Click="Rate_Click" AutomationProperties.Name="Playback speed" />
        </Grid>

        <!-- Bottom band: elapsed/total under the waveform, time + ticks on the right. -->
        <Grid VerticalAlignment="Bottom" Margin="50,0,0,0">
            <TextBlock x:Name="DurationText" Style="{StaticResource MetaTextStyle}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="3">
                <TextBlock x:Name="TimeText" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                <controls:DeliveryTicks x:Name="Ticks" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
