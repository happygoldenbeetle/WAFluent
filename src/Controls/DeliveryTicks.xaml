<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WhatsAppNative.Controls.DeliveryTicks"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid Width="15" Height="11" VerticalAlignment="Center">
        <Path x:Name="SinglePath" Data="M1,5.5 L4,8.5 L10,1.5"
              Stroke="{ThemeResource SentTickBrush}" StrokeThickness="1.4"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        <Path x:Name="DoublePath" Data="M0.5,5.5 L3.5,8.5 L9.5,1.5 M6,8.5 L12.5,1.5"
              Stroke="{ThemeResource SentTickBrush}" StrokeThickness="1.4" Visibility="Collapsed"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        <Path x:Name="ReadPath" Data="M0.5,5.5 L3.5,8.5 L9.5,1.5 M6,8.5 L12.5,1.5"
              Stroke="{ThemeResource ReadTickBrush}" StrokeThickness="1.4" Visibility="Collapsed"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        <!-- Still sending: a small clock. -->
        <Path x:Name="PendingPath" Data="M5.5,1 A4.5,4.5 0 1 1 5.49,1 Z M5.5,3.2 L5.5,5.7 L7.3,6.7"
              Stroke="{ThemeResource SentTickBrush}" StrokeThickness="1.1" Visibility="Collapsed"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        <!-- Not sent: right-click the message to try again. -->
        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" x:Name="FailedIcon" Glyph="&#xE783;" FontSize="11" HorizontalAlignment="Left" Visibility="Collapsed"
                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
    </Grid>
</UserControl>
