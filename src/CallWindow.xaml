<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WhatsAppNative.CallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhatsAppNative.Controls"
    Title="WAFluent call">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Takes the focus the window opens with, so no button is one stray Enter away
             (Decline, when someone is calling) and none starts with a focus ring. -->
        <ContentControl x:Name="FocusRest" Width="0" Height="0" IsTabStop="True" UseSystemFocusVisuals="False" />

        <!-- Title bar -->
        <Grid x:Name="CallTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
                <TextBlock Text="WhatsApp" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="End-to-end encrypted" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Caller card -->
        <Grid Grid.Row="1" Margin="8,0,8,0" CornerRadius="8"
              Background="{ThemeResource ChatPaneBackgroundBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <controls:TiledBackground Background="{ThemeResource WallpaperColorBrush}" Source="{ThemeResource WallpaperTile}"
                                      TileOpacity="{ThemeResource WallpaperTileOpacity}" Opacity="0.7"
                                      TileWidth="{ThemeResource WallpaperTileWidth}" TileHeight="{ThemeResource WallpaperTileHeight}" />
            <StackPanel x:Name="CallerPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <controls:Redact VeilRadius="48" HorizontalAlignment="Center">
                    <controls:Avatar x:Name="CallerAvatar" Size="96" HorizontalAlignment="Center" />
                </controls:Redact>
                <controls:Redact HorizontalAlignment="Center">
                    <TextBlock x:Name="CallerName" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="360" />
                </controls:Redact>
                <!-- A call with several people: who's in it. -->
                <controls:Redact HorizontalAlignment="Center">
                    <TextBlock x:Name="CallPeople" Visibility="Collapsed" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="360" MaxLines="2" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </controls:Redact>
                <!-- Voice level: the bars follow the two voices while connected. -->
                <StackPanel x:Name="Wave" Height="30" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" />
                <TextBlock x:Name="CallStatus" FontSize="18" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="360"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- Something you should know (the microphone couldn't be opened). -->
                <TextBlock x:Name="CallNote" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="340" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </StackPanel>

            <!-- Their picture (Services/CallVideoPlayer.cs), over the card while their camera is on. -->
            <Grid x:Name="RemoteVideoHost" Visibility="Collapsed" Background="Black">
                <MediaPlayerElement x:Name="RemoteVideo" AreTransportControlsEnabled="False" Stretch="Uniform" />
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,5" CornerRadius="6" Background="#99000000">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Redact>
                            <TextBlock x:Name="VideoName" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                        </controls:Redact>
                        <TextBlock x:Name="VideoClock" Foreground="#CCFFFFFF" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="VideoNote" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                           FontSize="12" Foreground="#FFFFD470" TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center" />
            </Grid>

            <!-- Your camera, the way a mirror shows you, in the corner. -->
            <Border x:Name="PreviewFrame" Visibility="Collapsed" Width="168" Height="96" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="12" CornerRadius="8" Background="Black" BorderBrush="#33FFFFFF" BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">
                <!-- The whole frame is flipped (it's symmetric), so its rounded corners still clip the picture. -->
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </Border.RenderTransform>
                <Image x:Name="PreviewImage" Stretch="UniformToFill" />
            </Border>

            <!-- They asked to switch the call to video. -->
            <Grid x:Name="VideoRequest" Visibility="Collapsed" VerticalAlignment="Top" Margin="12" Padding="14,8,6,8" CornerRadius="8" ColumnSpacing="8"
                  Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="VideoRequestText" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Switch" Style="{StaticResource AccentButtonStyle}" Click="VideoSwitch_Click" />
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Not now" AutomationProperties.Name="Not now"
                        Click="VideoDismiss_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Grid>

        <!-- Someone is calling: decline or answer. -->
        <StackPanel x:Name="RingButtons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="36"
                    Margin="0,18,0,20" Visibility="Collapsed">
            <Button Width="64" Height="44" Padding="0" CornerRadius="22" BorderThickness="0"
                    ToolTipService.ToolTip="Decline" AutomationProperties.Name="Decline" Click="Decline_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#E0463C" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#CC3D34" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B3352D" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6FFFFFF" />
                </Button.Resources>
                <FontIcon Glyph="&#xE717;" FontSize="18" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform Angle="135" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
            <Button Width="64" Height="44" Padding="0" CornerRadius="22" BorderThickness="0"
                    ToolTipService.ToolTip="Accept" AutomationProperties.Name="Accept" Click="Accept_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#1DAA61" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#199655" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#15824A" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6FFFFFF" />
                </Button.Resources>
                <FontIcon Glyph="&#xE717;" FontSize="18" />
            </Button>
        </StackPanel>

        <!-- In a call -->
        <StackPanel x:Name="CallButtons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,18,0,20">
            <Button Style="{StaticResource CallButtonStyle}" IsEnabled="False"
                    ToolTipService.ToolTip="Add participant" AutomationProperties.Name="Add participant">
                <FontIcon Glyph="&#xE8FA;" FontSize="16" />
            </Button>
            <ToggleButton x:Name="CameraToggle" Style="{StaticResource CallToggleStyle}" IsEnabled="False"
                          ToolTipService.ToolTip="Camera" AutomationProperties.Name="Camera"
                          Checked="Camera_Changed" Unchecked="Camera_Changed">
                <FontIcon Glyph="&#xE714;" FontSize="16" />
            </ToggleButton>
            <ToggleButton x:Name="MuteToggle" Style="{StaticResource CallToggleStyle}"
                          ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute"
                          Checked="Mute_Changed" Unchecked="Mute_Changed">
                <FontIcon x:Name="MuteIcon" Glyph="&#xE720;" FontSize="16" />
            </ToggleButton>
            <!-- More: which microphone and camera the call uses. -->
            <Button Style="{StaticResource CallButtonStyle}" ToolTipService.ToolTip="Microphone and camera" AutomationProperties.Name="Microphone and camera"
                    Click="More_Click">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
            </Button>
            <Button Width="64" Height="44" Padding="0" CornerRadius="22" BorderThickness="0"
                    ToolTipService.ToolTip="End call" AutomationProperties.Name="End call" Click="EndCall_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#E0463C" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#CC3D34" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B3352D" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6FFFFFF" />
                </Button.Resources>
                <!-- A phone receiver turned face-down reads as "hang up". -->
                <FontIcon Glyph="&#xE717;" FontSize="18" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform Angle="135" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
        </StackPanel>
    </Grid>
</Window>
