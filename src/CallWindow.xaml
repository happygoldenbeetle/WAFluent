<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WhatsAppNative.CallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhatsAppNative.Controls"
    Title="WAFluent call">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="CallTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
                <TextBlock Text="WhatsApp" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="End-to-end encrypted" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Caller card -->
        <Grid Grid.Row="1" Margin="8,0,8,0" CornerRadius="8"
              Background="{ThemeResource ChatPaneBackgroundBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <controls:TiledBackground Background="{ThemeResource WallpaperColorBrush}" Source="{ThemeResource WallpaperTile}"
                                      TileOpacity="{ThemeResource WallpaperTileOpacity}" Opacity="0.7"
                                      TileWidth="{ThemeResource WallpaperTileWidth}" TileHeight="{ThemeResource WallpaperTileHeight}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <controls:Avatar x:Name="CallerAvatar" Size="96" HorizontalAlignment="Center" />
                <TextBlock x:Name="CallerName" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="360" />
                <!-- Voice level: bars are sized from code while connected. -->
                <StackPanel x:Name="Wave" Height="30" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" />
                <TextBlock x:Name="CallStatus" FontSize="18" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,18,0,20">
            <Button Style="{StaticResource CallButtonStyle}" ToolTipService.ToolTip="Add participant" AutomationProperties.Name="Add participant">
                <FontIcon Glyph="&#xE8FA;" FontSize="16" />
            </Button>
            <ToggleButton x:Name="CameraToggle" Style="{StaticResource CallToggleStyle}"
                          ToolTipService.ToolTip="Camera" AutomationProperties.Name="Camera">
                <FontIcon Glyph="&#xE714;" FontSize="16" />
            </ToggleButton>
            <ToggleButton x:Name="MuteToggle" Style="{StaticResource CallToggleStyle}"
                          ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute"
                          Checked="Mute_Changed" Unchecked="Mute_Changed">
                <FontIcon x:Name="MuteIcon" Glyph="&#xE720;" FontSize="16" />
            </ToggleButton>
            <Button Style="{StaticResource CallButtonStyle}" ToolTipService.ToolTip="More" AutomationProperties.Name="More options">
                <FontIcon Glyph="&#xE712;" FontSize="16" />
            </Button>
            <Button Width="64" Height="44" Padding="0" CornerRadius="22" BorderThickness="0"
                    ToolTipService.ToolTip="End call" AutomationProperties.Name="End call" Click="EndCall_Click">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#E0463C" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#CC3D34" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B3352D" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6FFFFFF" />
                </Button.Resources>
                <!-- A phone receiver turned face-down reads as "hang up". -->
                <FontIcon Glyph="&#xE717;" FontSize="18" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform Angle="135" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Button>
        </StackPanel>
    </Grid>
</Window>
