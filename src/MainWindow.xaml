<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WhatsAppNative.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhatsAppNative.Controls"
    xmlns:helpers="using:WhatsAppNative.Helpers"
    xmlns:models="using:WhatsAppNative.Models"
    xmlns:vm="using:WhatsAppNative.ViewModels"
    Title="WAFluent">

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- ───────────── Media, links and docs: a photo or video tile (MainWindow.Gallery.cs) ───────────── -->
            <DataTemplate x:Key="GalleryTileTemplate" x:DataType="models:Message">
                <Grid CornerRadius="4" Background="{ThemeResource FileCardBrush}" Tag="{x:Bind}" Tapped="GalleryTile_Tapped" helpers:HandCursor.On="True"
                      CanDrag="True" DragStarting="Media_DragStarting">
                    <Border>
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind helpers:Ui.Thumb(Thumb)}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind helpers:Ui.GalleryImage(MediaPath, Kind), Mode=OneWay}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border VerticalAlignment="Bottom" Height="30" Visibility="{x:Bind helpers:Ui.IsVideoTile(Kind)}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#99000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,5"
                                Visibility="{x:Bind helpers:Ui.IsVideoTile(Kind)}">
                        <FontIcon Glyph="{x:Bind helpers:Ui.VideoTileGlyph(IsGif)}" FontSize="12" Foreground="White" />
                        <TextBlock Text="{x:Bind helpers:Ui.VideoTileText(IsGif, Seconds)}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                    <ProgressRing Width="24" Height="24" Foreground="White" IsActive="{x:Bind IsMediaLoading, Mode=OneWay}" />
                </Grid>
            </DataTemplate>

            <!-- ───────────── New chat: a contact (MainWindow.NewChat.cs) ───────────── -->
            <DataTemplate x:Key="NewChatRowTemplate" x:DataType="models:ContactRow">
                <Grid Height="64" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:Redact VeilRadius="24" VerticalAlignment="Center">
                        <controls:Avatar DisplayName="{x:Bind Name}" Source="{x:Bind AvatarPath}" Size="48" />
                    </controls:Redact>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <controls:Redact HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
                        </controls:Redact>
                        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasSubtitle, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- ───────────── Chat list item ───────────── -->
            <DataTemplate x:Key="ChatItemTemplate" x:DataType="models:Chat">
                <Grid Padding="0,9" ColumnSpacing="12" Background="Transparent"
                      Tag="{x:Bind}" ContextRequested="Chat_ContextRequested">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <controls:Redact VeilRadius="24">
                            <controls:Avatar DisplayName="{x:Bind Name, Mode=OneWay}" Source="{x:Bind AvatarPath, Mode=OneWay}"
                                             Size="48" ShowRing="{x:Bind HasStatus}" IsGroup="{x:Bind IsGroup}" />
                        </controls:Redact>
                        <!-- Disappearing messages on: a timer on the picture's corner. -->
                        <Grid Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                              Visibility="{x:Bind HasEphemeral, Mode=OneWay}">
                            <Ellipse Fill="{ThemeResource ChatAccentBrush}" Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2" />
                            <FontIcon Glyph="&#xE916;" FontSize="9" Foreground="White" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <controls:Redact HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </controls:Redact>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Groups: who sent the last message ("Maya: "), blurred in developer mode. -->
                            <controls:Redact Visibility="{x:Bind helpers:Ui.TextUnlessTyping(PreviewSender, PreviewHidden), Mode=OneWay}" Margin="0,0,3,0">
                                <TextBlock Text="{x:Bind PreviewSender, Mode=OneWay}" FontSize="13" MaxLines="1"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </controls:Redact>
                            <!-- Nudged down so the ticks sit on the text's baseline, not above it. -->
                            <controls:DeliveryTicks Grid.Column="1" Delivery="{x:Bind LastDelivery, Mode=OneWay}" Margin="0,5,4,0"
                                                    Visibility="{x:Bind helpers:Ui.DeliveryUnlessTyping(LastDelivery, PreviewHidden), Mode=OneWay}" />
                            <FontIcon Grid.Column="2" Glyph="{x:Bind PreviewGlyph, Mode=OneWay}" FontSize="13" Margin="0,0,5,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Visibility="{x:Bind helpers:Ui.TextUnlessTyping(PreviewGlyph, PreviewHidden), Mode=OneWay}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Preview, Mode=OneWay}" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                       Visibility="{x:Bind helpers:Ui.Collapsed(PreviewHidden), Mode=OneWay}" />
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="4" Text="{x:Bind TypingText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource ChatAccentTextBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                       Visibility="{x:Bind helpers:Ui.Visible(IsTyping), Mode=OneWay}" />
                            <!-- Unsent text from when you last had this chat open, like WhatsApp. -->
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="4" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1"
                                       Visibility="{x:Bind ShowDraft, Mode=OneWay}">
                                <Run Text="Draft:" FontWeight="SemiBold" Foreground="{ThemeResource ChatAccentTextBrush}" />
                                <Run Text="{x:Bind DraftLine, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5">
                        <Grid HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind Time, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind helpers:Ui.Collapsed(HasUnread), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Time, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource ChatAccentTextBrush}"
                                       Visibility="{x:Bind helpers:Ui.Visible(HasUnread), Mode=OneWay}" />
                        </Grid>
                        <!-- Bell and pin measured to the same ink height and centre line (13 px bell, 14 px pin
                             tilted 45° and dropped 1 px), 8 px apart. -->
                        <StackPanel Height="16" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <!-- Muted: a filled bell with a slash, like the phone (Material "notifications_off"). -->
                            <Path Width="13" Height="13" Stretch="Uniform" Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind IsMuted, Mode=OneWay}" Data="M20,18.69 L7.84,6.14 L5.27,3.49 L4,4.76 L6.8,7.56 L6.8,7.57 C6.28,8.56 6,9.73 6,10.99 V15.99 L4,17.99 V18.99 H17.73 L19.73,20.99 L21,19.72 Z M12,22 C13.11,22 14,21.11 14,20 H10 C10,21.11 10.89,22 12,22 Z M18,14.68 V11 C18,7.92 16.36,5.36 13.5,4.68 V4 C13.5,3.17 12.83,2.5 12,2.5 C11.17,2.5 10.5,3.17 10.5,4 V4.68 C9.5,4.92 8.62,5.4 7.92,6.07 Z" />
                            <!-- An upright pushpin, head and needle (Material "push_pin" outline, filled). -->
                            <Path Width="14" Height="14" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                                  Fill="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsPinned, Mode=OneWay}"
                                  Data="M16,9 V4 H17 C17.55,4 18,3.55 18,3 C18,2.45 17.55,2 17,2 H7 C6.45,2 6,2.45 6,3 C6,3.55 6.45,4 7,4 H8 V9 C8,10.66 6.66,12 5,12 V14 H10.97 V21 L11.97,22 L12.97,21 V14 H19 V12 C17.34,12 16,10.66 16,9 Z">
                                <Path.RenderTransform>
                                    <CompositeTransform TranslateY="0.5" />
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="@" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{ThemeResource ChatAccentTextBrush}"
                                       Visibility="{x:Bind helpers:Ui.Both(HasMention, HasUnread), Mode=OneWay}" />
                            <InfoBadge Value="{x:Bind Unread, Mode=OneWay}" Background="{ThemeResource ChatAccentBrush}"
                                       Visibility="{x:Bind ShowUnreadCount, Mode=OneWay}" />
                            <!-- Marked as unread: a dot with no number, like the phone. -->
                            <Ellipse Width="16" Height="16" Fill="{ThemeResource ChatAccentBrush}" VerticalAlignment="Center"
                                     Visibility="{x:Bind ShowUnreadDot, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- ───────────── Message templates ─────────────
                 Each root aligns left/right and can carry a reaction pill under the bubble. -->
            <helpers:MessageTemplateSelector x:Key="MessageTemplates">
                <helpers:MessageTemplateSelector.Text>
                    <DataTemplate x:DataType="models:Message">
                        <Grid Tag="{x:Bind}" ContextRequested="Message_ContextRequested" Margin="-28,0,-28,0" Padding="28,1,28,1"
                              Background="{x:Bind helpers:Ui.SelectionTint(IsSelected), Mode=OneWay}">
                            <!-- Select mode: a circle in the left gutter, ticked when picked. -->
                            <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-24,0,0,0"
                                  Visibility="{x:Bind Selecting, Mode=OneWay}">
                                <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
                                <Ellipse Fill="{ThemeResource ChatAccentBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                            </Grid>
                        <StackPanel HorizontalAlignment="{x:Bind helpers:Ui.Align(IsOutgoing)}">
                            <!-- 10 px all round; the text's margins below trim the space above the first line's
                                 capitals and under the last baseline, so the words sit optically centred. -->
                            <controls:Bubble IsOutgoing="{x:Bind IsOutgoing}" Tail="{x:Bind HasTail, Mode=OneWay}" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Group chats: who wrote it. -->
                                    <StackPanel>
                                        <controls:Redact HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{x:Bind ShowSender}">
                                            <TextBlock Text="{x:Bind SenderName}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextLineBounds="Tight" Foreground="{ThemeResource ChatAccentTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </controls:Redact>
                                        <!-- Forwarded: an arrow and the words, in grey italics, like WhatsApp. -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,-2,0,8" Visibility="{x:Bind IsForwarded}">
                                            <FontIcon Glyph="&#xE97A;" FontSize="11" Foreground="{ThemeResource MetaTextBrush}" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform></FontIcon>
                                            <TextBlock Text="{x:Bind ForwardedText}" FontSize="12" FontStyle="Italic" Foreground="{ThemeResource MetaTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Replies: the quoted message, inset 4 px from the bubble edge. -->
                                    <controls:QuoteBlock Grid.Row="1" Author="{x:Bind ReplyName}" Preview="{x:Bind ReplyPreview}" Glyph="{x:Bind ReplyGlyph}"
                                                         FromMe="{x:Bind ReplyFromMe}" Visibility="{x:Bind HasReply}" Margin="-6,-6,-6,10"
                                                         Tag="{x:Bind}" Tapped="Quote_Tapped" helpers:HandCursor.On="True" />
                                    <!-- The transparent TimeSpacer run reserves room for the timestamp on the last line. -->
                                    <!-- Full line spacing between lines; the negative margins trim only the space above the
                                         first line's capitals (5.3) and below the last baseline (3.5), so the 10 px padding
                                         reads evenly around the words. (TextLineBounds="Tight" trims every line and makes
                                         wrapped lines overlap.) -->
                                    <!-- Link preview: the sender's card (picture, title, description, site). Click opens the link. -->
                                    <Border Grid.Row="2" Margin="-6,-6,-6,10" CornerRadius="{x:Bind LinkCardCorners}" Background="{ThemeResource FileCardBrush}"
                                            Visibility="{x:Bind HasLink}" Tag="{x:Bind}" Tapped="Link_Tapped" helpers:HandCursor.On="True" MaxWidth="420" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="84" MinHeight="84" CornerRadius="6,0,0,6" Visibility="{x:Bind HasThumb}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{x:Bind helpers:Ui.Thumb(Thumb)}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,8" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind LinkTitle}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                           Visibility="{x:Bind helpers:Ui.NotEmpty(LinkTitle)}" />
                                                <TextBlock Text="{x:Bind LinkDescription}" FontSize="12" Foreground="{ThemeResource MetaTextBrush}" TextWrapping="Wrap"
                                                           MaxLines="2" TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasLinkDescription}" />
                                                <TextBlock Text="{x:Bind LinkHost}" FontSize="12" Foreground="{ThemeResource MetaTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="3" TextWrapping="Wrap" IsTextSelectionEnabled="True" ContextFlyout="{x:Null}" FontSize="14"
                                               Margin="0,-5.3,0,-3.5" FontStyle="{x:Bind helpers:Ui.Italic(IsDeleted)}" controls:LinkText.Message="{x:Bind}" />
                                    <!-- Time on the same baseline as the last line of text. -->
                                    <StackPanel Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Orientation="Horizontal" Spacing="3">
                                        <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{ThemeResource MetaTextBrush}" VerticalAlignment="Bottom"
                                                  Margin="0,0,1,0" Visibility="{x:Bind Starred}" />
                                        <TextBlock Text="Edited" Style="{StaticResource MetaTextStyle}" TextLineBounds="Tight" VerticalAlignment="Bottom"
                                                   Margin="8,0,2,0" Visibility="{x:Bind Edited}" />
                                        <TextBlock Text="{x:Bind Time}" Style="{StaticResource MetaTextStyle}" TextLineBounds="Tight" VerticalAlignment="Bottom" />
                                        <controls:DeliveryTicks Delivery="{x:Bind Delivery, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,-2"
                                                                Visibility="{x:Bind helpers:Ui.Visible(IsOutgoing)}" />
                                    </StackPanel>
                                </Grid>
                            </controls:Bubble>
                            <Border x:Name="ReactionPill" Style="{StaticResource ReactionPillStyle}" Visibility="{x:Bind helpers:Ui.NotEmpty(Reaction), Mode=OneWay}">
                                <TextBlock Text="{x:Bind Reaction, Mode=OneWay}" FontSize="12" />
                            </Border>
                        </StackPanel>
                        </Grid>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.Text>

                <helpers:MessageTemplateSelector.Image>
                    <DataTemplate x:DataType="models:Message">
                        <Grid Tag="{x:Bind}" ContextRequested="Message_ContextRequested" Margin="-28,0,-28,0" Padding="28,1,28,1"
                              Background="{x:Bind helpers:Ui.SelectionTint(IsSelected), Mode=OneWay}">
                            <!-- Select mode: a circle in the left gutter, ticked when picked. -->
                            <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-24,0,0,0"
                                  Visibility="{x:Bind Selecting, Mode=OneWay}">
                                <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
                                <Ellipse Fill="{ThemeResource ChatAccentBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                            </Grid>
                        <StackPanel HorizontalAlignment="{x:Bind helpers:Ui.Align(IsOutgoing)}">
                            <controls:Bubble IsOutgoing="{x:Bind IsOutgoing}" Tail="{x:Bind HasTail, Mode=OneWay}" Padding="4">
                                <StackPanel Width="{x:Bind MediaWidth}">
                                    <!-- Forwarded: an arrow and the words, in grey italics, like WhatsApp. -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,4,6,6" Visibility="{x:Bind IsForwarded}">
                                        <FontIcon Glyph="&#xE97A;" FontSize="11" Foreground="{ThemeResource MetaTextBrush}" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform></FontIcon>
                                        <TextBlock Text="{x:Bind ForwardedText}" FontSize="12" FontStyle="Italic" Foreground="{ThemeResource MetaTextBrush}" />
                                    </StackPanel>
                                    <controls:QuoteBlock Author="{x:Bind ReplyName}" Preview="{x:Bind ReplyPreview}" Glyph="{x:Bind ReplyGlyph}" Thumb="{x:Bind ReplyThumb}"
                                                         FromMe="{x:Bind ReplyFromMe}" Visibility="{x:Bind HasReply}" Margin="0,0,0,4"
                                                         Tag="{x:Bind}" Tapped="Quote_Tapped" helpers:HandCursor.On="True" />
                                    <!-- Click opens the picture in the viewer. -->
                                    <Grid Height="{x:Bind MediaHeight}" CornerRadius="{x:Bind PictureCorners}" Background="{ThemeResource FileCardBrush}"
                                          Tag="{x:Bind}" Tapped="Media_Tapped" helpers:HandCursor.On="True"
                                          CanDrag="True" DragStarting="Media_DragStarting">
                                        <!-- The sender's tiny preview (blurry by nature) until the picture arrives. -->
                                        <Border>
                                            <Border.Background>
                                                <ImageBrush ImageSource="{x:Bind helpers:Ui.Thumb(Thumb)}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <ProgressRing Width="32" Height="32" IsActive="{x:Bind IsMediaLoading, Mode=OneWay}" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                                    Visibility="{x:Bind MediaFailed, Mode=OneWay}">
                                            <FontIcon Glyph="&#xEB9F;" FontSize="28" Foreground="{ThemeResource MetaTextBrush}" />
                                            <TextBlock Text="Photo unavailable" FontSize="12" Foreground="{ThemeResource MetaTextBrush}" />
                                        </StackPanel>
                                        <Border CornerRadius="{x:Bind PictureCorners}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{x:Bind helpers:Ui.Image(MediaPath), Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <!-- Uploading: a spinning ring around ✕ (cancels), like WhatsApp. -->
                                        <Grid Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{x:Bind IsUploading, Mode=OneWay}">
                                            <Ellipse Fill="#99000000" />
                                            <ProgressRing Width="54" Height="54" Foreground="White" IsActive="{x:Bind IsUploading, Mode=OneWay}" />
                                            <Button Width="40" Height="40" Padding="0" CornerRadius="20" Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Tag="{x:Bind}" Click="CancelUpload_Click"
                                                    ToolTipService.ToolTip="Cancel" AutomationProperties.Name="Cancel upload">
                                                <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="White" />
                                            </Button>
                                        </Grid>
                                        <!-- Without a caption the time sits on the picture. -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="6,1,6,2"
                                                CornerRadius="9" Background="#66000000" Visibility="{x:Bind helpers:Ui.Collapsed(HasText)}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="{x:Bind Time}" FontSize="11" Foreground="White" />
                                                <controls:DeliveryTicks Delivery="{x:Bind Delivery, Mode=OneWay}" Visibility="{x:Bind helpers:Ui.Visible(IsOutgoing)}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <!-- Caption: 10 px from the picture and the bubble edges (4 bubble + 6 here). -->
                                    <Grid Padding="6,10,6,6" Visibility="{x:Bind HasText}">
                                        <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" ContextFlyout="{x:Null}" FontSize="14"
                                                   Margin="0,-5.3,0,-3.5" controls:LinkText.Message="{x:Bind}" />
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Orientation="Horizontal" Spacing="3">
                                            <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{ThemeResource MetaTextBrush}" VerticalAlignment="Bottom"
                                                  Margin="0,0,1,0" Visibility="{x:Bind Starred}" />
                                        <TextBlock Text="Edited" Style="{StaticResource MetaTextStyle}" TextLineBounds="Tight" VerticalAlignment="Bottom"
                                                   Margin="8,0,2,0" Visibility="{x:Bind Edited}" />
                                        <TextBlock Text="{x:Bind Time}" Style="{StaticResource MetaTextStyle}" TextLineBounds="Tight" VerticalAlignment="Bottom" />
                                            <controls:DeliveryTicks Delivery="{x:Bind Delivery, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,-2"
                                                                    Visibility="{x:Bind helpers:Ui.Visible(IsOutgoing)}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </controls:Bubble>
                            <Border x:Name="ReactionPill" Style="{StaticResource ReactionPillStyle}" Visibility="{x:Bind helpers:Ui.NotEmpty(Reaction), Mode=OneWay}">
                                <TextBlock Text="{x:Bind Reaction, Mode=OneWay}" FontSize="12" />
                            </Border>
                        </StackPanel>
                        </Grid>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.Image>

                <helpers:MessageTemplateSelector.Voice>
                    <DataTemplate x:DataType="models:Message">
                        <Grid Tag="{x:Bind}" ContextRequested="Message_ContextRequested" Margin="-28,0,-28,0" Padding="28,1,28,1"
                              Background="{x:Bind helpers:Ui.SelectionTint(IsSelected), Mode=OneWay}">
                            <!-- Select mode: a circle in the left gutter, ticked when picked. -->
                            <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-24,0,0,0"
                                  Visibility="{x:Bind Selecting, Mode=OneWay}">
                                <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
                                <Ellipse Fill="{ThemeResource ChatAccentBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                            </Grid>
                        <StackPanel HorizontalAlignment="{x:Bind helpers:Ui.Align(IsOutgoing)}">
                            <controls:Bubble IsOutgoing="{x:Bind IsOutgoing}" Tail="{x:Bind HasTail, Mode=OneWay}" Padding="8,4,10,4">
                                <StackPanel>
                                    <controls:Redact HorizontalAlignment="Left" Margin="0,0,0,2" Visibility="{x:Bind ShowSender}">
                                        <TextBlock Text="{x:Bind SenderName}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ChatAccentTextBrush}" />
                                    </controls:Redact>
                                    <!-- Forwarded: an arrow and the words, in grey italics, like WhatsApp. -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,2" Visibility="{x:Bind IsForwarded}">
                                        <FontIcon Glyph="&#xE97A;" FontSize="11" Foreground="{ThemeResource MetaTextBrush}" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform></FontIcon>
                                        <TextBlock Text="{x:Bind ForwardedText}" FontSize="12" FontStyle="Italic" Foreground="{ThemeResource MetaTextBrush}" />
                                    </StackPanel>
                                    <controls:QuoteBlock Author="{x:Bind ReplyName}" Preview="{x:Bind ReplyPreview}" Glyph="{x:Bind ReplyGlyph}" Thumb="{x:Bind ReplyThumb}"
                                                         FromMe="{x:Bind ReplyFromMe}" Visibility="{x:Bind HasReply}" Margin="-4,0,-6,0"
                                                         Tag="{x:Bind}" Tapped="Quote_Tapped" helpers:HandCursor.On="True" />
                                    <controls:VoicePlayer Message="{x:Bind}" />
                                </StackPanel>
                            </controls:Bubble>
                            <Border x:Name="ReactionPill" Style="{StaticResource ReactionPillStyle}" Visibility="{x:Bind helpers:Ui.NotEmpty(Reaction), Mode=OneWay}">
                                <TextBlock Text="{x:Bind Reaction, Mode=OneWay}" FontSize="12" />
                            </Border>
                        </StackPanel>
