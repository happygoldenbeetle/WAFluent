<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WhatsAppNative.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhatsAppNative.Controls"
    xmlns:helpers="using:WhatsAppNative.Helpers"
    xmlns:models="using:WhatsAppNative.Models"
    Title="WhatsApp Native">

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- ───────────── Chat list item ───────────── -->
            <DataTemplate x:Key="ChatItemTemplate" x:DataType="models:Chat">
                <Grid Padding="0,9" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:Avatar DisplayName="{x:Bind Name, Mode=OneWay}" Source="{x:Bind AvatarPath, Mode=OneWay}"
                                     Size="48" ShowRing="{x:Bind HasStatus}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:DeliveryTicks Delivery="{x:Bind LastDelivery, Mode=OneWay}" Margin="0,0,4,0"
                                                    Visibility="{x:Bind helpers:Ui.HasDelivery(LastDelivery), Mode=OneWay}" />
                            <FontIcon Grid.Column="1" Glyph="{x:Bind PreviewGlyph, Mode=OneWay}" FontSize="13" Margin="0,0,5,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Visibility="{x:Bind helpers:Ui.NotEmpty(PreviewGlyph), Mode=OneWay}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Preview, Mode=OneWay}" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                       Visibility="{x:Bind helpers:Ui.Collapsed(IsTyping)}" />
                            <TextBlock Grid.Column="2" Text="typing…" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{x:Bind helpers:Ui.Visible(IsTyping)}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5">
                        <Grid HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind Time, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind helpers:Ui.Collapsed(HasUnread), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Time, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{x:Bind helpers:Ui.Visible(HasUnread), Mode=OneWay}" />
                        </Grid>
                        <StackPanel Height="16" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE718;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Visibility="{x:Bind IsPinned, Mode=OneWay}" />
                            <TextBlock Text="@" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{x:Bind helpers:Ui.Both(HasMention, HasUnread), Mode=OneWay}" />
                            <InfoBadge Value="{x:Bind Unread, Mode=OneWay}"
                                       Visibility="{x:Bind helpers:Ui.Visible(HasUnread), Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- ───────────── Message templates ─────────────
                 Each root aligns left/right and can carry a reaction pill under the bubble. -->
            <helpers:MessageTemplateSelector x:Key="MessageTemplates">
                <helpers:MessageTemplateSelector.Text>
                    <DataTemplate x:DataType="models:Message">
                        <StackPanel HorizontalAlignment="{x:Bind helpers:Ui.Align(IsOutgoing)}">
                            <controls:Bubble IsOutgoing="{x:Bind IsOutgoing}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Group chats: who wrote it. -->
                                    <TextBlock Text="{x:Bind SenderName}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,1"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" Visibility="{x:Bind ShowSender}" />
                                    <!-- The transparent TimeSpacer run reserves room for the timestamp on the last line. -->
                                    <TextBlock Grid.Row="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="14">
                                        <Run Text="{x:Bind Text}" /><Run Text="{x:Bind TimeSpacer}" FontSize="11" Foreground="Transparent" />
                                    </TextBlock>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-3"
                                                Orientation="Horizontal" Spacing="3">
                                        <TextBlock Text="{x:Bind Time}" Style="{StaticResource MetaTextStyle}" />
                                        <controls:DeliveryTicks Delivery="{x:Bind Delivery}" Visibility="{x:Bind helpers:Ui.Visible(IsOutgoing)}" />
                                    </StackPanel>
                                </Grid>
                            </controls:Bubble>
                            <Border Style="{StaticResource ReactionPillStyle}" Visibility="{x:Bind helpers:Ui.NotEmpty(Reaction)}">
                                <TextBlock Text="{x:Bind Reaction}" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.Text>

                <helpers:MessageTemplateSelector.Image>
                    <DataTemplate x:DataType="models:Message">
                        <StackPanel HorizontalAlignment="{x:Bind helpers:Ui.Align(IsOutgoing)}">
                            <controls:Bubble IsOutgoing="{x:Bind IsOutgoing}" Padding="4">
                                <StackPanel Width="300">
                                    <Border Height="190" CornerRadius="6" Background="{ThemeResource FileCardBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xEB9F;" FontSize="32" Foreground="{ThemeResource MetaTextBrush}"
                                                      Visibility="{x:Bind helpers:Ui.IsNull(ImagePath)}" />
                                            <Border CornerRadius="6">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{x:Bind helpers:Ui.Image(ImagePath)}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Grid Padding="5,6,5,2">
                                        <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="14"
                                                   Visibility="{x:Bind HasText}">
                                            <Run Text="{x:Bind Text}" /><Run Text="{x:Bind TimeSpacer}" FontSize="11" Foreground="Transparent" />
                                        </TextBlock>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-3"
                                                    Orientation="Horizontal" Spacing="3">
                                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource MetaTextStyle}" />
                                            <controls:DeliveryTicks Delivery="{x:Bind Delivery}" Visibility="{x:Bind helpers:Ui.Visible(IsOutgoing)}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </controls:Bubble>
                            <Border Style="{StaticResource ReactionPillStyle}" Visibility="{x:Bind helpers:Ui.NotEmpty(Reaction)}">
                                <TextBlock Text="{x:Bind Reaction}" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.Image>

                <helpers:MessageTemplateSelector.File>
                    <DataTemplate x:DataType="models:Message">
                        <StackPanel HorizontalAlignment="{x:Bind helpers:Ui.Align(IsOutgoing)}">
                            <controls:Bubble IsOutgoing="{x:Bind IsOutgoing}" Padding="6">
                                <StackPanel Width="330" Spacing="4">
                                    <Border Background="{ThemeResource FileCardBrush}" CornerRadius="6" Padding="10,12,10,10">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind helpers:Ui.FileIcon(FileName)}" FontSize="28" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind FileDetails}" FontSize="12" Foreground="{ThemeResource MetaTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                            <Rectangle Height="1" Margin="-10,0" Fill="{ThemeResource FileCardDividerBrush}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Open" Style="{StaticResource BubbleActionButtonStyle}" />
                                                <Button Grid.Column="1" Content="Save As…" Style="{StaticResource BubbleActionButtonStyle}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="3" Margin="0,0,3,0">
                                        <TextBlock Text="{x:Bind Time}" Style="{StaticResource MetaTextStyle}" />
                                        <controls:DeliveryTicks Delivery="{x:Bind Delivery}" Visibility="{x:Bind helpers:Ui.Visible(IsOutgoing)}" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:Bubble>
                        </StackPanel>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.File>

                <helpers:MessageTemplateSelector.DateDivider>
                    <DataTemplate x:DataType="models:Message">
                        <Border HorizontalAlignment="Center" Margin="0,10" Padding="12,4"
                                Background="{ThemeResource DatePillBrush}" CornerRadius="6">
                            <TextBlock Text="{x:Bind Text}" FontSize="12" Foreground="{ThemeResource MetaTextBrush}" />
                        </Border>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.DateDivider>
            </helpers:MessageTemplateSelector>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═════════════ Title bar ═════════════ -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
                <TextBlock Text="WhatsApp Native" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ═════════════ Navigation rail + content ═════════════ -->
        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="240"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Chats" Tag="Chats" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.UnreadChats, Mode=OneWay}"
                                   Visibility="{x:Bind helpers:Ui.Positive(ViewModel.UnreadChats), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Calls" Tag="Calls">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE717;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Status" Tag="Status">
                    <NavigationViewItem.Icon>
                        <!-- Double ring, drawn: the icon font has no status glyph. -->
                        <PathIcon Data="F0 M8,0.75 A7.25,7.25 0 1 1 7.99,0.75 Z M8,2.1 A5.9,5.9 0 1 1 7.99,2.1 Z M8,4.6 A3.4,3.4 0 1 1 7.99,4.6 Z M8,5.95 A2.05,2.05 0 1 1 7.99,5.95 Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Starred messages" Tag="Starred">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Archived chats" Tag="Archived">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Profile photo; the placeholder is swapped for the real picture once linked. -->
                <NavigationViewItem Content="Profile" Tag="Profile">
                    <NavigationViewItem.Resources>
                        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
                    </NavigationViewItem.Resources>
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="{x:Bind ViewModel.ProfileIcon, Mode=OneWay}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ───────────── Chat list pane ───────────── -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,10,8,8">
                        <TextBlock x:Name="ListTitle" Text="Chats" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel x:Name="ListActions" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="New chat" AutomationProperties.Name="New chat">
                                <FontIcon Glyph="&#xE932;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Filter" AutomationProperties.Name="Filter chats">
                                <PathIcon Data="M1,3 H15 V4.3 H1 Z M3.5,7.4 H12.5 V8.7 H3.5 Z M6,11.8 H10 V13.1 H6 Z" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Margin="16,0,16,8"
                                    PlaceholderText="Search or start a new chat"
                                    QueryIcon="Find"
                                    AutomationProperties.Name="Search chats"
                                    TextChanged="Search_TextChanged" />

                    <!-- Reconnecting / syncing while chats are already on screen. -->
                    <Grid Grid.Row="2" Margin="16,0,16,8" Padding="12,8" ColumnSpacing="10" CornerRadius="6"
                          Background="{ThemeResource LayerFillColorAltBrush}"
                          Visibility="{x:Bind ViewModel.ShowBanner, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.ShowBanner, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BannerText, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </Grid>

                    <ListView x:Name="ChatList" Grid.Row="3" Margin="4,0,4,0"
                              ItemsSource="{x:Bind ViewModel.Chats}"
                              ItemTemplate="{StaticResource ChatItemTemplate}"
                              SingleSelectionFollowsFocus="False"
                              SelectionChanged="ChatList_SelectionChanged" />

                    <StackPanel x:Name="SectionPlaceholder" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon x:Name="SectionPlaceholderIcon" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="SectionPlaceholderText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="LogoutButton" Content="Log out" HorizontalAlignment="Center" Margin="0,8,0,0"
                                Visibility="Collapsed" Click="Logout_Click" />
                    </StackPanel>
                </Grid>

                <!-- ───────────── Conversation pane ───────────── -->
                <Grid Grid.Column="1" Background="{ThemeResource ChatPaneBackgroundBrush}"
                      BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="1,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1" Background="{ThemeResource WallpaperBrush}" />

                    <Grid Height="58" Padding="16,0,10,0" ColumnSpacing="12"
                          Background="{ThemeResource ChatHeaderBackgroundBrush}"
                          BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="0,0,0,1"
                          Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:Avatar DisplayName="{x:Bind ViewModel.SelectedChat.Name, Mode=OneWay}"
                                         Source="{x:Bind ViewModel.SelectedChat.AvatarPath, Mode=OneWay}"
                                         Size="36" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.SelectedChat.Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedChat.Status, Mode=OneWay}" FontSize="12"
                                       Visibility="{x:Bind helpers:Ui.NotEmpty(ViewModel.SelectedChat.Status), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Video call" AutomationProperties.Name="Video call"
                                    Click="VideoCall_Click">
                                <FontIcon Glyph="&#xE714;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Voice call" AutomationProperties.Name="Voice call"
                                    Click="VoiceCall_Click">
                                <FontIcon Glyph="&#xE717;" FontSize="16" />
                            </Button>
                            <Rectangle Width="1" Height="18" Margin="6,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Search" AutomationProperties.Name="Search in chat">
                                <FontIcon Glyph="&#xE721;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="MessagesScroller" Grid.Row="1" Padding="28,8,28,12"
                                  Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                  ViewChanged="MessagesScroller_ViewChanged">
                        <StackPanel>
                            <!-- Older messages on their way (from this PC or the phone). -->
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,8"
                                        Visibility="{x:Bind ViewModel.SelectedChat.LoadingOlder, Mode=OneWay}">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.SelectedChat.LoadingOlder, Mode=OneWay}" />
                                <TextBlock Text="Loading older messages…" FontSize="12" Foreground="{ThemeResource MetaTextBrush}" />
                            </StackPanel>
                            <ItemsRepeater x:Name="Messages"
                                           ItemsSource="{x:Bind ViewModel.SelectedChat.Messages, Mode=OneWay}"
                                           ItemTemplate="{StaticResource MessageTemplates}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Composer: docked bar; the mic becomes Send once there is text. -->
                    <Grid Grid.Row="2" Padding="10,6" ColumnSpacing="2"
                          Background="{ThemeResource ComposerBrush}"
                          BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="0,1,0,0"
                          Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Emoji" AutomationProperties.Name="Emoji"
                                Click="Emoji_Click">
                            <FontIcon Glyph="&#xE76E;" FontSize="17" />
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Attach" AutomationProperties.Name="Attach">
                            <FontIcon Glyph="&#xE723;" FontSize="17" />
                        </Button>
                        <TextBox x:Name="ComposerBox" Grid.Column="2"
                                 PlaceholderText="{x:Bind ViewModel.ComposerPlaceholder}"
                                 IsEnabled="{x:Bind ViewModel.CanSend}"
                                 AutomationProperties.Name="Message"
                                 VerticalAlignment="Center" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="140"
                                 BorderThickness="0" Background="Transparent" Padding="6"
                                 TextChanged="ComposerBox_TextChanged"
                                 PreviewKeyDown="ComposerBox_PreviewKeyDown">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                        <Grid Grid.Column="3">
                            <Button x:Name="MicButton" Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Voice message" AutomationProperties.Name="Voice message">
                                <FontIcon Glyph="&#xE720;" FontSize="17" />
                            </Button>
                            <Button x:Name="SendButton" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Send" AutomationProperties.Name="Send" Click="Send_Click">
                                <FontIcon Glyph="&#xE724;" FontSize="17" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Nothing selected -->
                    <StackPanel Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.HasSelection), Mode=OneWay}">
                        <Image Source="ms-appx:///Assets/AppIcon.png" Width="72" />
                        <TextBlock Text="WhatsApp Native" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Pick a chat to start messaging." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- ═════════════ Link your phone (live mode, until chats are available) ═════════════ -->
        <Grid Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              Visibility="{x:Bind ViewModel.ShowLinkScreen, Mode=OneWay}">
            <Border MaxWidth="920" Margin="32" Padding="40,36" VerticalAlignment="Center" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="22" VerticalAlignment="Center">
                        <TextBlock Text="Use WhatsApp on your computer" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">Open <Bold>WhatsApp</Bold> on your phone</TextBlock>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">Tap <Bold>Menu ⋮</Bold> on Android, or <Bold>Settings</Bold> on iPhone</TextBlock>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">Tap <Bold>Linked devices</Bold>, then <Bold>Link a device</Bold></TextBlock>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">Point your phone at this screen to scan the QR code</TextBlock>
                            </Grid>
                        </StackPanel>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Unofficial client"
                                 Message="WAFluent isn't made by WhatsApp. Meta can suspend accounts that use unofficial apps, so a spare number is safest for now." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Width="280" Spacing="16" VerticalAlignment="Center">
                        <!-- Always black on white so it scans in dark mode too. -->
                        <Border Width="264" Height="264" Padding="6" CornerRadius="8" Background="White" HorizontalAlignment="Center">
                            <Grid>
                                <Image Source="{x:Bind ViewModel.QrImage, Mode=OneWay}" Stretch="Uniform"
                                       Visibility="{x:Bind ViewModel.ShowQr, Mode=OneWay}"
                                       AutomationProperties.Name="Pairing QR code" />
                                <ProgressRing Width="44" Height="44" Foreground="#00A884"
                                              IsActive="{x:Bind ViewModel.ShowLinkProgress, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.ShowLinkProgress, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.LinkStatusText, Mode=OneWay}" TextWrapping="Wrap"
                                   HorizontalTextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
