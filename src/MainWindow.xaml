                                                         Tag="{x:Bind}" Tapped="Quote_Tapped" helpers:HandCursor.On="True" />
                                    <!-- A sharp street map (Controls/MapView.cs); click opens the place in Google Maps. -->
                                    <Grid Height="150" CornerRadius="{x:Bind MapCorners}" Background="{ThemeResource FileCardBrush}" Tag="{x:Bind}" Tapped="Location_Tapped" helpers:HandCursor.On="True">
                                        <FontIcon Glyph="&#xE707;" FontSize="32" Foreground="{ThemeResource MetaTextBrush}" />
                                        <controls:MapView Latitude="{x:Bind Latitude}" Longitude="{x:Bind Longitude}" Thumb="{x:Bind Thumb}" CornerRadius="{x:Bind MapCorners}" />
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="8,2,8,3" CornerRadius="9"
                                                Background="{ThemeResource DangerBrush}" Visibility="{x:Bind IsLiveLocation}">
                                            <TextBlock Text="LIVE" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                        <!-- Where a click takes you. -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="5,2,8,3" CornerRadius="9" Background="#F2FFFFFF">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <!-- Google Maps' 2020 pin. -->
                                                <Viewbox Width="10" Height="14" VerticalAlignment="Center">
                                                    <Canvas Width="92.3" Height="132.3">
                                                        <Path Fill="#1A73E8" Data="M60.2 2.2C55.8.8 51 0 46.1 0 32 0 19.3 6.4 10.8 16.5l21.8 18.3L60.2 2.2z" />
