                                    </Grid>
                                    <!-- A named place (a shop, a landmark): its name and address under the map. -->
                                    <Grid Padding="6,10,6,6" Visibility="{x:Bind HasPlaceText}">
                                        <StackPanel Spacing="2" Margin="0,0,0,16">
                                            <TextBlock Text="{x:Bind PlaceTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind PlaceAddress}" FontSize="12" Foreground="{ThemeResource MetaTextBrush}" TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasPlaceAddress}" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="3">
                                            <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{ThemeResource MetaTextBrush}" VerticalAlignment="Bottom"
                                                      Margin="0,0,1,0" Visibility="{x:Bind Starred}" />
                                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource MetaTextStyle}" TextLineBounds="Tight" VerticalAlignment="Bottom" />
                                            <controls:DeliveryTicks Delivery="{x:Bind Delivery, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,-2"
                                                                    Visibility="{x:Bind helpers:Ui.Visible(IsOutgoing)}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </controls:Bubble>
                            <Border x:Name="ReactionPill" Style="{StaticResource ReactionPillStyle}" Visibility="{x:Bind helpers:Ui.NotEmpty(Reaction), Mode=OneWay}">
                                <TextBlock Text="{x:Bind Reaction, Mode=OneWay}" FontSize="12" />
                            </Border>
                        </StackPanel>
                        </Grid>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.Location>

                <helpers:MessageTemplateSelector.Contact>
                    <DataTemplate x:DataType="models:Message">
                        <!-- Shared contact cards. -->
                        <Grid Tag="{x:Bind}" ContextRequested="Message_ContextRequested" Margin="-28,0,-28,0" Padding="28,1,28,1"
                              Background="{x:Bind helpers:Ui.SelectionTint(IsSelected), Mode=OneWay}">
                            <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-24,0,0,0"
                                  Visibility="{x:Bind Selecting, Mode=OneWay}">
                                <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
                                <Ellipse Fill="{ThemeResource ChatAccentBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                            </Grid>
                        <StackPanel HorizontalAlignment="{x:Bind helpers:Ui.Align(IsOutgoing)}">
                            <controls:Bubble IsOutgoing="{x:Bind IsOutgoing}" Tail="{x:Bind HasTail, Mode=OneWay}" Padding="6">
                                <StackPanel Width="280">
                                    <controls:Redact HorizontalAlignment="Left" Margin="4,2,4,6" Visibility="{x:Bind ShowSender}">
                                        <TextBlock Text="{x:Bind SenderName}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ChatAccentTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </controls:Redact>
                                    <!-- Forwarded: an arrow and the words, in grey italics, like WhatsApp. -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0,4,6" Visibility="{x:Bind IsForwarded}">
                                        <FontIcon Glyph="&#xE97A;" FontSize="11" Foreground="{ThemeResource MetaTextBrush}" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform></FontIcon>
                                        <TextBlock Text="{x:Bind ForwardedText}" FontSize="12" FontStyle="Italic" Foreground="{ThemeResource MetaTextBrush}" />
                                    </StackPanel>
                                    <controls:QuoteBlock Author="{x:Bind ReplyName}" Preview="{x:Bind ReplyPreview}" Glyph="{x:Bind ReplyGlyph}" Thumb="{x:Bind ReplyThumb}"
                                                         FromMe="{x:Bind ReplyFromMe}" Visibility="{x:Bind HasReply}" Margin="-2,-2,-2,4"
                                                         Tag="{x:Bind}" Tapped="Quote_Tapped" helpers:HandCursor.On="True" />
                                    <Grid ColumnSpacing="12" Padding="4,4,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:Redact VeilRadius="22">
                                            <controls:Avatar DisplayName="{x:Bind ContactTitle}" Size="44" />
                                        </controls:Redact>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <controls:Redact HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind ContactTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </controls:Redact>
                                            <controls:Redact HorizontalAlignment="Left" Visibility="{x:Bind helpers:Ui.NotEmpty(ContactSubtitle)}">
                                                <TextBlock Text="{x:Bind ContactSubtitle}" FontSize="12" Foreground="{ThemeResource MetaTextBrush}" />
                                            </controls:Redact>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Height="22" Margin="0,0,3,0">
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="3">
                                            <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{ThemeResource MetaTextBrush}" VerticalAlignment="Bottom"
                                                      Margin="0,0,1,0" Visibility="{x:Bind Starred}" />
                                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource MetaTextStyle}" TextLineBounds="Tight" VerticalAlignment="Bottom" />
                                            <controls:DeliveryTicks Delivery="{x:Bind Delivery, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,-2"
                                                                    Visibility="{x:Bind helpers:Ui.Visible(IsOutgoing)}" />
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Margin="-6,4,-6,0" Fill="{ThemeResource FileCardDividerBrush}" />
                                    <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Message" Style="{StaticResource BubbleActionButtonStyle}" Tag="{x:Bind}" Click="ContactMessage_Click"
                                                IsEnabled="{x:Bind HasContactPhone}" />
                                        <Button Grid.Column="1" Content="{x:Bind helpers:Ui.ContactAction(Contacts.Count)}" Style="{StaticResource BubbleActionButtonStyle}"
                                                Tag="{x:Bind}" Click="ContactMore_Click" IsEnabled="{x:Bind HasContactPhone}" />
                                    </Grid>
                                </StackPanel>
                            </controls:Bubble>
                            <Border x:Name="ReactionPill" Style="{StaticResource ReactionPillStyle}" Visibility="{x:Bind helpers:Ui.NotEmpty(Reaction), Mode=OneWay}">
                                <TextBlock Text="{x:Bind Reaction, Mode=OneWay}" FontSize="12" />
                            </Border>
                        </StackPanel>
                        </Grid>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.Contact>

                <helpers:MessageTemplateSelector.Poll>
                    <DataTemplate x:DataType="models:Message">
                        <!-- Polls: tap an option to vote; counts and bars from everyone's votes (synced with the phone). -->
                        <Grid Tag="{x:Bind}" ContextRequested="Message_ContextRequested" Margin="-28,0,-28,0" Padding="28,1,28,1"
                              Background="{x:Bind helpers:Ui.SelectionTint(IsSelected), Mode=OneWay}">
                            <Grid Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-24,0,0,0"
                                  Visibility="{x:Bind Selecting, Mode=OneWay}">
                                <Ellipse Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" />
                                <Ellipse Fill="{ThemeResource ChatAccentBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White" Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                            </Grid>
                        <StackPanel HorizontalAlignment="{x:Bind helpers:Ui.Align(IsOutgoing)}">
                            <controls:Bubble IsOutgoing="{x:Bind IsOutgoing}" Tail="{x:Bind HasTail, Mode=OneWay}" Padding="10">
                                <StackPanel Width="300" Spacing="10">
                                    <controls:Redact HorizontalAlignment="Left" Margin="0,0,0,-2" Visibility="{x:Bind ShowSender}">
                                        <TextBlock Text="{x:Bind SenderName}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ChatAccentTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </controls:Redact>
                                    <!-- Forwarded: an arrow and the words, in grey italics, like WhatsApp. -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,-2" Visibility="{x:Bind IsForwarded}">
                                        <FontIcon Glyph="&#xE97A;" FontSize="11" Foreground="{ThemeResource MetaTextBrush}" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform></FontIcon>
                                        <TextBlock Text="{x:Bind ForwardedText}" FontSize="12" FontStyle="Italic" Foreground="{ThemeResource MetaTextBrush}" />
                                    </StackPanel>
                                    <controls:QuoteBlock Author="{x:Bind ReplyName}" Preview="{x:Bind ReplyPreview}" Glyph="{x:Bind ReplyGlyph}" Thumb="{x:Bind ReplyThumb}"
                                                         FromMe="{x:Bind ReplyFromMe}" Visibility="{x:Bind HasReply}" Margin="-6,-6,-6,0"
                                                         Tag="{x:Bind}" Tapped="Quote_Tapped" helpers:HandCursor.On="True" />
                                    <TextBlock Text="{x:Bind Text}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               ContextFlyout="{x:Null}" Margin="0,-4,0,0" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,-4,0,0">
                                        <FontIcon Glyph="&#xE9D5;" FontSize="12" Foreground="{ThemeResource MetaTextBrush}" />
                                        <TextBlock Text="{x:Bind PollHint}" FontSize="12" Foreground="{ThemeResource MetaTextBrush}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{x:Bind PollOptions, Mode=OneWay}" IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PollOption">
                                                <Grid ColumnSpacing="10" RowSpacing="7" Padding="0,5" Background="Transparent" Tag="{x:Bind}" Tapped="PollOption_Tapped" helpers:HandCursor.On="True"
                                                      Loaded="PollOption_Loaded">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <!-- A hollow circle; when it's yours, a green fill (with a tick) covers it. The name and
                                                         bar together are centred on it: from the tops of the capitals (not the text box, which
                                                         has room above them) to the bottom of the bar, hence 3.5 px lower than the box centre. -->
                                                    <Grid Grid.RowSpan="2" Width="20" Height="20" VerticalAlignment="Center" Margin="0,7,0,0">
                                                        <Border CornerRadius="{x:Bind helpers:Ui.PollMark(Multi)}" BorderThickness="1.6"
                                                                BorderBrush="{ThemeResource MetaTextBrush}" />
                                                        <Border x:Name="PollCheck" CornerRadius="{x:Bind helpers:Ui.PollMark(Multi)}" Background="{ThemeResource ChatAccentBrush}" Visibility="{x:Bind Selected}">
                                                            <FontIcon x:Name="PollTick" Glyph="&#xE73E;" FontSize="11" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind CountLabel}" FontSize="13" Foreground="{ThemeResource MetaTextBrush}" VerticalAlignment="Center" />
                                                    <!-- The fill is sized (not stretched) so both ends stay fully round at any length. -->
                                                    <Grid x:Name="PollTrack" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Height="6" SizeChanged="PollTrack_SizeChanged">
                                                        <Border CornerRadius="3" Background="{ThemeResource FileCardDividerBrush}" />
                                                        <Border x:Name="PollFill" CornerRadius="3" Background="{ThemeResource ChatAccentBrush}"
                                                                HorizontalAlignment="Left" Width="0" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="3">
                                            <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{ThemeResource MetaTextBrush}" VerticalAlignment="Bottom"
                                                      Margin="0,0,1,0" Visibility="{x:Bind Starred}" />
                                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource MetaTextStyle}" TextLineBounds="Tight" VerticalAlignment="Bottom" />
                                            <controls:DeliveryTicks Delivery="{x:Bind Delivery, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,-2"
                                                                    Visibility="{x:Bind helpers:Ui.Visible(IsOutgoing)}" />
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Margin="-10,0" Fill="{ThemeResource FileCardDividerBrush}" />
                                    <Button Content="View votes" Style="{StaticResource BubbleActionButtonStyle}" HorizontalAlignment="Stretch" Margin="0,-4,0,-4"
                                            Tag="{x:Bind}" Click="PollVotes_Click" IsEnabled="{x:Bind HasVotes, Mode=OneWay}" />
                                </StackPanel>
                            </controls:Bubble>
                            <Border x:Name="ReactionPill" Style="{StaticResource ReactionPillStyle}" Visibility="{x:Bind helpers:Ui.NotEmpty(Reaction), Mode=OneWay}">
                                <TextBlock Text="{x:Bind Reaction, Mode=OneWay}" FontSize="12" />
                            </Border>
                        </StackPanel>
                        </Grid>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.Poll>

                <helpers:MessageTemplateSelector.System>
                    <DataTemplate x:DataType="models:Message">
                        <!-- WhatsApp's own notices: missed calls, group changes... -->
                        <Border HorizontalAlignment="Center" Margin="0,4" Padding="14,6" MaxWidth="520"
                                Background="{ThemeResource DatePillBrush}" CornerRadius="8">
                            <controls:Redact>
                                <!-- Disappearing-messages notices start with a timer and end in "Change timer." (opens
                                     that page); the others are just their text. The timer is an icon set into the line
                                     and dropped 3 px so it's centred on the words. One line: spaces between runs would show. -->
                                <RichTextBlock FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19"
                                               Foreground="{ThemeResource MetaTextBrush}" IsTextSelectionEnabled="True" ContextFlyout="{x:Null}">
                                    <Paragraph><InlineUIContainer><FontIcon Glyph="&#xE916;" FontSize="13" Margin="0,0,6,-3" Foreground="{ThemeResource MetaTextBrush}" Visibility="{x:Bind IsTimerNotice}" /></InlineUIContainer><Run Text="{x:Bind Text}" /><Hyperlink UnderlineStyle="None" Click="ChangeTimer_Click" Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run Text="{x:Bind NoticeLink}" FontWeight="SemiBold" /></Hyperlink></Paragraph>
                                </RichTextBlock>
                            </controls:Redact>
                        </Border>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.System>

                <helpers:MessageTemplateSelector.DateDivider>
                    <DataTemplate x:DataType="models:Message">
                        <!-- WhatsApp's pill: #1D1F1F in dark, 8 px corners, bold grey text. -->
                        <Border HorizontalAlignment="Center" Margin="0,10" Padding="14,6"
                                Background="{ThemeResource DatePillBrush}" CornerRadius="8">
                            <TextBlock Text="{x:Bind Text}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource MetaTextBrush}"
                                       IsTextSelectionEnabled="True" ContextFlyout="{x:Null}" />
                        </Border>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.DateDivider>
                <!-- Photos and videos sent together (Controls/AlbumGrid.cs). -->
                <helpers:MessageTemplateSelector.Album>
                    <DataTemplate x:DataType="models:Message">
                        <Grid Tag="{x:Bind}" Margin="-28,0,-28,0" Padding="28,1,28,1">
                            <StackPanel HorizontalAlignment="{x:Bind helpers:Ui.Align(IsOutgoing)}">
                                <controls:Bubble IsOutgoing="{x:Bind IsOutgoing}" Tail="{x:Bind HasTail, Mode=OneWay}" Padding="3">
                                    <StackPanel>
                                        <controls:Redact HorizontalAlignment="Left" Margin="7,3,6,5" Visibility="{x:Bind ShowSender}">
                                            <TextBlock Text="{x:Bind SenderName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource ChatAccentTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </controls:Redact>
                                        <!-- Forwarded: an arrow and the words, in grey italics, like WhatsApp. -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="7,2,6,5" Visibility="{x:Bind IsForwarded}">
                                            <FontIcon Glyph="&#xE97A;" FontSize="11" Foreground="{ThemeResource MetaTextBrush}" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform></FontIcon>
                                            <TextBlock Text="{x:Bind ForwardedText}" FontSize="12" FontStyle="Italic" Foreground="{ThemeResource MetaTextBrush}" />
                                        </StackPanel>
                                        <Grid>
                                            <controls:AlbumGrid Album="{x:Bind}" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="6,1,6,2"
                                                    CornerRadius="9" Background="#66000000" IsHitTestVisible="False">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{x:Bind Time}" FontSize="11" Foreground="White" />
                                                    <controls:DeliveryTicks Delivery="{x:Bind Delivery, Mode=OneWay}" Visibility="{x:Bind helpers:Ui.Visible(IsOutgoing)}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </controls:Bubble>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.Album>
                <!-- Opening a chat: a band above the first unread message (the chat opens there). -->
                <helpers:MessageTemplateSelector.UnreadDivider>
                    <DataTemplate x:DataType="models:Message">
                        <Border Margin="-28,12" Padding="0,5" Background="{ThemeResource UnreadBandBrush}">
                            <Border HorizontalAlignment="Center" Padding="14,6" CornerRadius="8" Background="{ThemeResource DatePillBrush}">
                                <TextBlock Text="{x:Bind Text}" FontSize="12.5" Foreground="{ThemeResource ChatAccentTextBrush}" FontWeight="SemiBold"
                                           IsTextSelectionEnabled="True" ContextFlyout="{x:Null}" />
                            </Border>
                        </Border>
                    </DataTemplate>
                </helpers:MessageTemplateSelector.UnreadDivider>
            </helpers:MessageTemplateSelector>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═════════════ Title bar ═════════════ -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
                <TextBlock Text="WAFluent" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ═════════════ Navigation rail + content ═════════════ -->
        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="240"
                        SelectionChanged="Nav_SelectionChanged"
                        ItemInvoked="Nav_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Chats" Tag="Chats" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.UnreadChats, Mode=OneWay}" Background="{ThemeResource ChatAccentBrush}"
                                   Visibility="{x:Bind helpers:Ui.Positive(ViewModel.UnreadChats), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Calls" Tag="Calls">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE717;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Status" Tag="Status">
                    <NavigationViewItem.Icon>
                        <!-- Double ring, drawn: the icon font has no status glyph. -->
                        <PathIcon Data="F0 M8,0.75 A7.25,7.25 0 1 1 7.99,0.75 Z M8,2.1 A5.9,5.9 0 1 1 7.99,2.1 Z M8,4.6 A3.4,3.4 0 1 1 7.99,4.6 Z M8,5.95 A2.05,2.05 0 1 1 7.99,5.95 Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Starred messages" Tag="Starred">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Archived chats" Tag="Archived">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Profile photo; the placeholder is swapped for the real picture once linked. -->
                <NavigationViewItem Content="Profile" Tag="Profile">
                    <NavigationViewItem.Resources>
                        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">24</x:Double>
                    </NavigationViewItem.Resources>
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="{x:Bind ViewModel.ProfileIcon, Mode=OneWay}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid x:Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <!-- Width comes from ui.json (MainWindow.ChatListPane.cs). -->
                    <ColumnDefinition x:Name="ChatListColumn" Width="340" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ───────────── Chat list pane ───────────── -->
                <Grid x:Name="ChatListPane">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,10,8,8">
                        <TextBlock x:Name="ListTitle" Text="Chats" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel x:Name="ListActions" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="New chat" AutomationProperties.Name="New chat"
                                    Click="NewChat_Click">
                                <FontIcon Glyph="&#xE932;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <AutoSuggestBox x:Name="SearchBox" Margin="16,0,16,8"
                                        PlaceholderText="Search or start a new chat"
                                        QueryIcon="Find"
                                        AutomationProperties.Name="Search chats"
                                        TextChanged="Search_TextChanged" />
                        <!-- All · Unread · Favourites · ⌄ (Groups), like WhatsApp for Windows (MainWindow.ChatMenu.cs). -->
                        <StackPanel x:Name="FilterChips" Orientation="Horizontal" Spacing="8" Margin="16,0,16,8" />
                        <!-- A voice note still playing after you've left its chat (MainWindow.MiniPlayer.cs). -->
                        <Grid x:Name="MiniPlayer" Margin="16,0,16,8" Padding="6,6,4,6" ColumnSpacing="8" CornerRadius="8"
                              Background="{ThemeResource LayerFillColorAltBrush}" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Width="34" Height="34" Padding="0" CornerRadius="17" BorderThickness="0" VerticalAlignment="Center"
                                    Background="{ThemeResource ChatAccentBrush}" Click="MiniPlay_Click" AutomationProperties.Name="Play or pause">
                                <FontIcon x:Name="MiniPlayIcon" Glyph="&#xE769;" FontSize="14" Foreground="White" />
                            </Button>
                            <Grid Grid.Column="1" Background="Transparent" Tapped="MiniOpen_Tapped" helpers:HandCursor.On="True" VerticalAlignment="Center" RowSpacing="3"
                                  ToolTipService.ToolTip="Go to message">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:Redact HorizontalAlignment="Left">
                                    <TextBlock x:Name="MiniName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </controls:Redact>
                                <TextBlock x:Name="MiniDetail" Grid.Row="1" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressBar x:Name="MiniProgress" Grid.Row="2" Maximum="1" MinHeight="2" Margin="0,2,0,0"
                                             Foreground="{ThemeResource ChatAccentBrush}" />
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="MiniRate_Click" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Playback speed" AutomationProperties.Name="Playback speed">
                                <TextBlock x:Name="MiniRate" Text="1×" FontSize="12" FontWeight="SemiBold" />
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="MiniClose_Click" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Stop" AutomationProperties.Name="Stop voice message">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Reconnecting / syncing while chats are already on screen. -->
                    <Grid Grid.Row="2" Margin="16,0,16,8" Padding="12,8" ColumnSpacing="10" CornerRadius="6"
                          Background="{ThemeResource LayerFillColorAltBrush}"
                          Visibility="{x:Bind ViewModel.ShowBanner, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.ShowBanner, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BannerText, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </Grid>

                    <!-- Right padding keeps the selected row's highlight clear of the scroll bar. -->
                    <ListView x:Name="ChatList" Grid.Row="3" Margin="4,0,0,0" Padding="0,0,6,0"
                              ItemsSource="{x:Bind ViewModel.Chats}"
                              ItemTemplate="{StaticResource ChatItemTemplate}"
                              SingleSelectionFollowsFocus="False"
                              SelectionChanged="ChatList_SelectionChanged">
                        <ListView.Resources>
                            <!-- No green bar on the selected chat; the row highlight is enough. -->
                            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                        </ListView.Resources>
                    </ListView>

                    <!-- Starred messages from every chat (rail: Starred messages). -->
                    <ListView x:Name="StarredList" Grid.Row="1" Grid.RowSpan="3" Margin="4,0,0,0" Padding="0,0,6,0" Visibility="Collapsed"
                              ItemsSource="{x:Bind ViewModel.Starred}" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="Starred_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StarredItem">
                                <Grid Padding="4,10" RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Redact HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind ChatName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </controls:Redact>
                                    <TextBlock Grid.Column="1" Text="{x:Bind When}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Preview}" FontSize="13" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="SectionPlaceholder" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon x:Name="SectionPlaceholderIcon" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="SectionPlaceholderText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Settings (MainWindow.Settings.cs) -->
                    <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" Padding="16,4,16,16">
                        <StackPanel Spacing="20">
                            <ComboBox x:Name="ThemeBox" Header="Theme" MinWidth="200" />
                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Name="MinimizeToTraySwitch" Header="Minimize and close to tray" OffContent="Off" OnContent="On" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Minimizing or closing hides WAFluent to the notification area; click its icon to bring it back. Right-click the icon for more, including Quit." />
                            </StackPanel>
                            <StackPanel Spacing="10">
                                <TextBlock Text="Quick reactions" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Shown when you right-click a message, next to + for any emoji. Double-click a message to react with the first one. Click an emoji to change it." />
                                <StackPanel x:Name="QuickReactionSlots" Orientation="Horizontal" Spacing="6" />
                                <HyperlinkButton Content="Reset to default" Padding="0" Click="ResetQuickReactions_Click" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Name="Use24HourSwitch" Header="Use 24-hour time" OffContent="Off" OnContent="On"
                                              Toggled="Use24Hour_Toggled" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Times as 18:27. Off: 6:27 pm." />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Name="HandCursorSwitch" Header="Hand pointer" OffContent="Off" OnContent="On"
                                              Toggled="HandCursor_Toggled" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="The pointer turns into a hand over anything you can click. Off: the usual arrow." />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Name="NotificationsSwitch" Header="Notifications" OffContent="Off" OnContent="On"
                                              Toggled="Notifications_Toggled" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="New messages show a Windows notification when WAFluent isn't in front or the chat isn't open, with a box to reply from it. Muted chats stay quiet." />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Name="HdMediaSwitch" Header="Send photos and videos in HD" OffContent="Off" OnContent="On"
                                              Toggled="HdMedia_Toggled" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Off: standard quality, smaller and faster to send, like WhatsApp (photos up to 1600 px, videos 480p). On: HD (photos up to 4096 px, videos 720p) when a photo or video is bigger than standard. You can switch it for each send with the HD button." />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Name="SystemAccentSwitch" Header="Use Windows accent colour" OffContent="Off" OnContent="On"
                                              Toggled="SystemAccent_Toggled" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Buttons, switches and the left bar use the colour from Windows Settings › Personalization › Colors. Unread badges and chats stay WhatsApp green." />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <ToggleSwitch x:Name="DeveloperModeSwitch" Header="Developer mode" OffContent="Off" OnContent="On"
                                              Toggled="DeveloperMode_Toggled" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Blurs profile photos, names and numbers, for screenshots and screen sharing. Messages stay readable." />
                            </StackPanel>
                            <Button x:Name="LogoutButton" Content="Log out" Visibility="Collapsed" Click="Logout_Click" />
                        </StackPanel>
                    </ScrollViewer>
                    <!-- ───── New chat (MainWindow.NewChat.cs): over the chat list ───── -->
                    <Grid x:Name="NewChatPane" Grid.RowSpan="4" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="8,4,8,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource IconButtonStyle}" Click="NewChatBack_Click" ToolTipService.ToolTip="Back"
                                        AutomationProperties.Name="Back">
                                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                                </Button>
                                <TextBlock x:Name="NewChatTitle" Text="New chat" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="NewChatDialpad" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                                    Click="NewChatDialpad_Click" ToolTipService.ToolTip="Phone number" AutomationProperties.Name="Phone number">
                                <FontIcon Glyph="&#xE75F;" FontSize="16" />
                            </Button>
                        </Grid>

                        <!-- Contacts by letter; also the list for picking group members. -->
                        <Grid x:Name="NewChatListPage" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <AutoSuggestBox x:Name="NewChatSearch" Margin="16,4,16,8" PlaceholderText="Search name or number" QueryIcon="Find"
                                            AutomationProperties.Name="Search contacts" TextChanged="NewChatSearch_TextChanged" />
                            <StackPanel x:Name="GroupChipsArea" Grid.Row="1" Visibility="Collapsed">
                                <controls:WrapPanel x:Name="GroupChips" Margin="20,4,16,8" HorizontalSpacing="14" VerticalSpacing="8" />
                                <Rectangle x:Name="GroupChipsDivider" Height="1" Margin="20,4,20,0" Visibility="Collapsed"
                                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            </StackPanel>
                            <ListView x:Name="NewChatList" Grid.Row="2" Margin="4,0,0,0" Padding="0,0,6,0" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="NewChatList_ItemClick" ItemTemplate="{StaticResource NewChatRowTemplate}">
                                <ListView.Header>
                                    <StackPanel x:Name="NewChatActions" Margin="0,0,0,4">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" BorderThickness="0"
                                                Background="Transparent" Click="NewGroup_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <Grid Width="48" Height="48">
                                                    <Ellipse Fill="{ThemeResource ChatAccentBrush}" />
                                                    <FontIcon Glyph="&#xE902;" FontSize="20" Foreground="#0B141A" />
                                                </Grid>
                                                <TextBlock Text="New group" FontSize="15" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" BorderThickness="0"
                                                Background="Transparent" Click="NewContact_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <Grid Width="48" Height="48">
                                                    <Ellipse Fill="{ThemeResource ChatAccentBrush}" />
                                                    <FontIcon Glyph="&#xE8FA;" FontSize="20" Foreground="#0B141A" />
                                                </Grid>
                                                <TextBlock Text="New contact" FontSize="15" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" BorderThickness="0"
                                                Background="Transparent" Click="MessageYourself_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <controls:Redact VeilRadius="24">
                                                    <controls:Avatar DisplayName="{x:Bind ViewModel.SelfName, Mode=OneWay}"
                                                                     Source="{x:Bind ViewModel.SelfAvatarPath, Mode=OneWay}" Size="48" />
                                                </controls:Redact>
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock FontSize="15"><Run Text="{x:Bind ViewModel.SelfName, Mode=OneWay}" /><Run Text=" (You)" /></TextBlock>
                                                    <TextBlock Text="Message yourself" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ListView.Header>
                                <ListView.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate x:DataType="models:ContactGroup">
                                                <TextBlock Text="{x:Bind Key}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListView.GroupStyle>
                            </ListView>
                            <TextBlock x:Name="NewChatEmpty" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="0,0,0,120" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
                            <!-- Group members picked: on to the group's name (a button like Chat and Save). -->
                            <Button x:Name="GroupNext" Grid.Row="3" Visibility="Collapsed" Content="Next" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Margin="16,8,16,16" Click="GroupNext_Click" />
                        </Grid>

                        <!-- A number you haven't saved: type or tap it, then Chat. -->
                        <StackPanel x:Name="NewChatNumberPage" Grid.Row="1" Visibility="Collapsed" Padding="16,4,16,16" Spacing="14">
                            <TextBox x:Name="NumberBox" PlaceholderText="Phone number" FontSize="16" InputScope="TelephoneNumber"
                                     TextChanged="NumberBox_TextChanged" KeyDown="NumberBox_KeyDown" />
                            <TextBlock Text="Enter a phone number with its country code to start a chat" TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid x:Name="NumberPad" MaxWidth="340">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                            </Grid>
                            <Button x:Name="NumberChat" Content="Chat" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                    IsEnabled="False" Click="NumberChat_Click" />
                        </StackPanel>

                        <!-- New contact: saved to WhatsApp (and the phone's address book, if asked). -->
                        <StackPanel x:Name="NewChatContactPage" Grid.Row="1" Visibility="Collapsed" Padding="16,8,16,16" Spacing="14">
                            <TextBox x:Name="NewContactFirst" Header="First name" TextChanged="NewContact_TextChanged" />
                            <TextBox x:Name="NewContactLast" Header="Last name" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewContactCode" Header="Country" PlaceholderText="+92" TextChanged="NewContact_TextChanged" />
                                <TextBox x:Name="NewContactPhone" Grid.Column="1" Header="Phone" InputScope="TelephoneNumber"
                                         TextChanged="NewContact_TextChanged" />
                            </Grid>
                            <ToggleSwitch x:Name="NewContactSync" Header="Sync contact to phone" OffContent="Off" OnContent="On" />
                            <TextBlock Text="When on, this contact is also added to your phone's address book." TextWrapping="Wrap" FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-8,0,0" />
                            <Button x:Name="NewContactSave" Content="Save" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                    IsEnabled="False" Click="NewContactSave_Click" />
                        </StackPanel>

                        <!-- New group: its name, then create. -->
                        <StackPanel x:Name="NewChatSubjectPage" Grid.Row="1" Visibility="Collapsed" Padding="16,8,16,16" Spacing="14">
                            <TextBox x:Name="GroupSubject" Header="Group name" MaxLength="100" TextChanged="GroupSubject_TextChanged" />
                            <TextBlock x:Name="GroupSubjectMembers" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="GroupCreate" Content="Create group" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                    IsEnabled="False" Click="GroupCreate_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ───────────── Conversation pane ───────────── -->
                <Grid x:Name="ConversationPane" Grid.Column="1" Background="{ThemeResource ChatPaneBackgroundBrush}"
                      BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="1,0,0,0"
                      AllowDrop="True" DragOver="Conversation_DragOver" DragLeave="Conversation_DragLeave" Drop="Conversation_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:TiledBackground Grid.Row="1" Grid.RowSpan="2" Background="{ThemeResource WallpaperColorBrush}"
                                              Source="{ThemeResource WallpaperTile}" TileOpacity="{ThemeResource WallpaperTileOpacity}"
                                              TileWidth="{ThemeResource WallpaperTileWidth}" TileHeight="{ThemeResource WallpaperTileHeight}" />

                    <Grid Height="58" Padding="16,0,10,0" ColumnSpacing="12"
                          Background="{ThemeResource ChatHeaderBackgroundBrush}"
                          BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="0,0,0,1"
                          Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:ClickArea VerticalAlignment="Center" Tapped="Header_Tapped" helpers:HandCursor.On="True">
                            <controls:Redact VeilRadius="18">
                                <controls:Avatar DisplayName="{x:Bind ViewModel.SelectedChat.Name, Mode=OneWay}"
                                                 Source="{x:Bind ViewModel.SelectedChat.AvatarPath, Mode=OneWay}" Size="36"
                                                 IsGroup="{x:Bind ViewModel.SelectedChat.IsGroup, Mode=OneWay, FallbackValue=False}" />
                            </controls:Redact>
                        </controls:ClickArea>
                        <!-- Click the photo or the name for Contact / Group info (MainWindow.ContactInfo.cs). -->
                        <controls:ClickArea Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Tapped="Header_Tapped" helpers:HandCursor.On="True">
                        <StackPanel>
                            <controls:Redact HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind ViewModel.SelectedChat.Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </controls:Redact>
                            <TextBlock Text="{x:Bind ViewModel.SelectedChat.Status, Mode=OneWay}" FontSize="12"
                                       Visibility="{x:Bind helpers:Ui.VisibleAndNot(ViewModel.SelectedChat.HasStatusText, ViewModel.SelectedChat.IsTyping), Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedChat.TypingText, Mode=OneWay}" FontSize="12"
                                       Visibility="{x:Bind helpers:Ui.Visible(ViewModel.SelectedChat.IsTyping), Mode=OneWay}"
                                       Foreground="{ThemeResource ChatAccentTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        </controls:ClickArea>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Video call" AutomationProperties.Name="Video call"
                                    Click="VideoCall_Click">
                                <FontIcon Glyph="&#xE714;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Voice call" AutomationProperties.Name="Voice call"
                                    Click="VoiceCall_Click">
                                <FontIcon Glyph="&#xE717;" FontSize="16" />
                            </Button>
                            <Rectangle Width="1" Height="18" Margin="6,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Search (Ctrl+F)" AutomationProperties.Name="Search in chat"
                                    Click="SearchChat_Click">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="F" />
                                </Button.KeyboardAccelerators>
                                <FontIcon Glyph="&#xE721;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Pinned messages (up to three): the banner shows one; click goes to it and on to the next.
                         The bars on the left say how many there are and which one this is (MainWindow.Pins.cs). -->
                    <Grid x:Name="PinnedBanner" Grid.Row="1" Padding="12,6,16,6" ColumnSpacing="12" Background="{ThemeResource ChatHeaderBackgroundBrush}"
                          BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="0,0,0,1"
                          Visibility="{x:Bind helpers:Ui.Visible(ViewModel.SelectedChat.HasPinnedMessage), Mode=OneWay, FallbackValue=Collapsed}"
                          Tapped="PinnedBanner_Tapped" helpers:HandCursor.On="True" ContextRequested="PinnedBanner_ContextRequested">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="PinSegments" Spacing="2" VerticalAlignment="Center" />
                        <!-- Segoe's pin leans 45°; turned upright. -->
                        <FontIcon Grid.Column="1" Glyph="&#xE840;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                            <FontIcon.RenderTransform>
                                <RotateTransform Angle="-45" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="PinnedTitle" Text="Pinned message" FontSize="12" Foreground="{ThemeResource ChatAccentTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedChat.PinnedMessagePreview, Mode=OneWay}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>
                    </Grid>

                    <!-- Anchored to the bottom: older messages arriving above, or rows measuring
                         taller than guessed, don't move what you're reading. -->
                    <ScrollViewer x:Name="MessagesScroller" Grid.Row="2" Padding="28,8,28,12" VerticalAnchorRatio="1"
                                  Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                  ViewChanged="MessagesScroller_ViewChanged">
                        <StackPanel>
                            <!-- Older messages on their way (from this PC or the phone). -->
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,8"
                                        Visibility="{x:Bind ViewModel.SelectedChat.LoadingOlder, Mode=OneWay}">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.SelectedChat.LoadingOlder, Mode=OneWay}" />
                                <TextBlock Text="Loading older messages…" FontSize="12" Foreground="{ThemeResource MetaTextBrush}" />
                            </StackPanel>
                            <Grid>
                                <!-- Drag a message to the right to reply (MainWindow.Swipe.cs). -->
                                <ItemsRepeater x:Name="Messages"
                                               ItemsSource="{x:Bind ViewModel.SelectedChat.Messages, Mode=OneWay}"
                                               ItemTemplate="{StaticResource MessageTemplates}">
                                    <ItemsRepeater.Layout>
                                        <!-- Remembers each row's height (Controls/ChatLayout.cs). -->
                                        <controls:ChatLayout Spacing="6" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <!-- The reply arrow that appears behind a message while it's dragged. -->
                                <Canvas x:Name="SwipeLayer" IsHitTestVisible="False">
                                    <Border x:Name="ReplyHint" Width="32" Height="32" CornerRadius="16"
                                            Background="{ThemeResource ComposerBrush}"
                                            BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="1">
                                        <FontIcon x:Name="SwipeHintIcon" Glyph="&#xE97A;" FontSize="14" />
                                    </Border>
                                </Canvas>
                            </Grid>
                            <!-- They're typing: three bobbing dots in an incoming bubble (Controls/TypingDots.cs). -->
                            <controls:Bubble x:Name="TypingBubble" Tail="True" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="14,12"
                                             Visibility="{x:Bind helpers:Ui.Visible(ViewModel.SelectedChat.IsTyping), Mode=OneWay}">
                                <controls:TypingDots DotBrush="{ThemeResource MetaTextBrush}" />
                            </controls:Bubble>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Scrolled up: a quiet round button back to the latest message, with how many arrived meanwhile. -->
                    <Grid x:Name="JumpDown" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,14" Visibility="Collapsed">
                        <Button Width="40" Height="40" CornerRadius="20" Padding="0" Click="JumpDown_Click"
                                Background="{ThemeResource ComposerBrush}" BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="1"
                                ToolTipService.ToolTip="Jump to latest" AutomationProperties.Name="Jump to the latest message">
                            <FontIcon Glyph="&#xE70D;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                        <InfoBadge x:Name="JumpDownBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-6,0"
                                   Background="{ThemeResource ChatAccentBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>

                    <!-- :shortcode: suggestions, just above the composer (MainWindow.Emoji.cs). -->
                    <Border x:Name="ShortcodePanel" Grid.Row="2" Visibility="Collapsed"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,8"
                            MinWidth="240" MaxWidth="360" Padding="4" CornerRadius="8" Translation="0,0,16"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <StackPanel x:Name="ShortcodeList" />
                    </Border>

                    <!-- @mention suggestions, like the :shortcode: list (MainWindow.Mentions.cs). -->
                    <Border x:Name="MentionPanel" Grid.Row="2" Visibility="Collapsed"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,8"
                            MinWidth="300" MaxWidth="420" MaxHeight="360" Padding="4" CornerRadius="8" Translation="0,0,16"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <ScrollViewer x:Name="MentionScroller">
                            <StackPanel x:Name="MentionList" />
                        </ScrollViewer>
                    </Border>

                    <!-- Composer: docked bar; the mic becomes Send once there is text. -->
                    <!-- Select mode replaces the composer: count, then copy / star / forward / delete. -->
                    <Grid Grid.Row="3" Padding="10,6" ColumnSpacing="4" MinHeight="52"
                          Background="{ThemeResource ComposerBrush}"
                          BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="0,1,0,0"
                          Visibility="{x:Bind ViewModel.IsSelecting, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Cancel (Esc)" AutomationProperties.Name="Cancel selection"
                                Click="SelectCancel_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Copy" AutomationProperties.Name="Copy selected" Click="SelectCopy_Click">
                                <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Star" AutomationProperties.Name="Star selected" Click="SelectStar_Click">
                                <FontIcon Glyph="&#xE734;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward selected" Click="SelectForward_Click">
                                <FontIcon Glyph="&#xE97A;" FontSize="16" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform></FontIcon>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Delete" AutomationProperties.Name="Delete selected" Click="SelectDelete_Click">
                                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Padding="10,6" ColumnSpacing="2"
                          Background="{ThemeResource ComposerBrush}"
                          BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="0,1,0,0"
                          Visibility="{x:Bind helpers:Ui.VisibleAndNot(ViewModel.HasSelection, ViewModel.IsSelecting), Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Replying to: the quoted message, with ✕ to cancel (or Esc). -->
                        <Grid Grid.ColumnSpan="4" Margin="4,2,0,6" ColumnSpacing="6"
                              Visibility="{x:Bind ViewModel.IsReplying, Mode=OneWay}" x:Name="ReplyBanner">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:QuoteBlock Author="{x:Bind ViewModel.ReplyingToName, Mode=OneWay}"
                                                 Preview="{x:Bind ViewModel.ReplyingToPreview, Mode=OneWay}"
                                                 Glyph="{x:Bind ViewModel.ReplyingToGlyph, Mode=OneWay}"
                                                 Thumb="{x:Bind ViewModel.ReplyingToThumb, Mode=OneWay}"
                                                 FromMe="{x:Bind ViewModel.ReplyingToFromMe, Mode=OneWay}"
                                                 Tapped="ComposerQuote_Tapped" helpers:HandCursor.On="True" ToolTipService.ToolTip="Go to message" />
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Cancel reply (Esc)" AutomationProperties.Name="Cancel reply"
                                    Click="CancelReply_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>
                        <!-- Editing one of your messages (MainWindow.Edit.cs): the composer holds its text. -->
                        <!-- The link card that will go with the message (MainWindow.LinkPreview.cs); ✕ sends it without. -->
                        <Grid x:Name="LinkCard" Grid.ColumnSpan="4" Margin="4,2,0,6" ColumnSpacing="6" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="6" Background="{ThemeResource QuoteBrush}" BorderBrush="{ThemeResource ChatAccentBrush}"
                                    BorderThickness="4,0,0,0" Height="76">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="LinkCardPicture" Width="76" Height="76" CornerRadius="0">
                                        <Border.Background>
                                            <ImageBrush x:Name="LinkCardImage" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Padding="0,0,10,0">
                                        <TextBlock x:Name="LinkCardTitle" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock x:Name="LinkCardDescription" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="LinkCardSite" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <!-- Loading: a skeleton of the card with a sweep of light. -->
                                    <Grid x:Name="LinkCardSkeleton" Grid.ColumnSpan="2" ColumnSpacing="12" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Padding="0,0,10,0">
                                            <Border Height="11" Width="220" HorizontalAlignment="Left" CornerRadius="5" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Border Height="9" Width="320" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Border Height="9" Width="90" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <controls:Shimmer x:Name="LinkCardShimmer" Grid.ColumnSpan="2" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Remove the preview" AutomationProperties.Name="Remove link preview" Click="LinkCardClose_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>
                        <Grid x:Name="EditBanner" Grid.ColumnSpan="4" Margin="4,2,0,6" ColumnSpacing="6" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="6" Background="{ThemeResource QuoteBrush}" BorderBrush="{ThemeResource ChatAccentBrush}"
                                    BorderThickness="4,0,0,0" Padding="10,6,10,6">
                                <StackPanel Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="{ThemeResource ChatAccentTextBrush}" />
                                        <TextBlock Text="Editing message" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ChatAccentTextBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="EditBannerText" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Cancel editing (Esc)" AutomationProperties.Name="Cancel editing" Click="CancelEdit_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>
                        <!-- + (attach menu), stickers and GIFs, emoji: WhatsApp's order. -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button x:Name="AttachButton" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Attach"
                                    AutomationProperties.Name="Attach" Click="Attach_Click">
                                <FontIcon Glyph="&#xE710;" FontSize="17" />
                            </Button>
                            <!-- Stickers and GIFs (Controls/StickerPanel.cs). -->
                            <Button x:Name="StickerButton" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Stickers and GIFs"
                                    AutomationProperties.Name="Stickers and GIFs" Click="Stickers_Click" />
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Emoji" AutomationProperties.Name="Emoji"
                                    Click="Emoji_Click">
                                <FontIcon Glyph="&#xE76E;" FontSize="17" />
                            </Button>
                        </StackPanel>
                        <!-- Recording a voice note (MainWindow.Voice.cs): delete, time, send. -->
                        <Grid x:Name="RecordingBar" Grid.Row="1" Grid.ColumnSpan="4" Visibility="Collapsed" Canvas.ZIndex="5"
                              Background="{ThemeResource ComposerBrush}" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Like WhatsApp: everything on the right, delete · time · waveform · pause · send. -->
                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="RecordingDelete_Click" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Delete (Esc)" AutomationProperties.Name="Delete recording">
                                <FontIcon Glyph="&#xE74D;" FontSize="17" />
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="4,0,8,0">
                                <Ellipse x:Name="RecordingDot" Width="10" Height="10" Fill="#F15C6D" VerticalAlignment="Center" />
                                <TextBlock x:Name="RecordingTime" Text="0:00" FontSize="16" VerticalAlignment="Center" MinWidth="38" />
                            </StackPanel>
                            <controls:LiveWaveform x:Name="RecordingWave" Grid.Column="3" Margin="0,0,10,0" />
                            <Button x:Name="RecordingPause" Grid.Column="4" Style="{StaticResource IconButtonStyle}" Click="RecordingPause_Click"
                                    VerticalAlignment="Center" ToolTipService.ToolTip="Pause" AutomationProperties.Name="Pause recording">
                                <FontIcon x:Name="RecordingPauseIcon" Glyph="&#xE769;" FontSize="16" Foreground="#F15C6D" />
                            </Button>
                            <Button x:Name="RecordingSend" Grid.Column="5" Style="{StaticResource SendFabStyle}" Margin="2,0,2,0"
                                    Click="RecordingSend_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Send (Enter)"
                                    AutomationProperties.Name="Send voice message" />
                        </Grid>
                        <TextBox x:Name="ComposerBox" Grid.Row="1" Grid.Column="2"
                                 PlaceholderText="{x:Bind ViewModel.ComposerPlaceholder}"
                                 IsEnabled="{x:Bind ViewModel.CanSend}"
                                 AutomationProperties.Name="Message"
                                 VerticalAlignment="Center" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="140"
                                 BorderThickness="0" Background="Transparent" Padding="6"
                                 TextChanged="ComposerBox_TextChanged"
                                 SelectionChanged="ComposerBox_SelectionChanged"
                                 PreviewKeyDown="ComposerBox_PreviewKeyDown"
                                 Paste="ComposerBox_Paste">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                        <Grid Grid.Row="1" Grid.Column="3">
                            <StackPanel x:Name="MicGroup" Orientation="Horizontal">
                                <Button x:Name="MicButton" Style="{StaticResource IconButtonStyle}" Click="Mic_Click"
                                        ToolTipService.ToolTip="Record a voice message" AutomationProperties.Name="Record a voice message">
                                    <FontIcon Glyph="&#xE720;" FontSize="17" />
                                </Button>
                                <!-- Which microphone records (MainWindow.Voice.cs): opens upwards. -->
                                <Button x:Name="MicDeviceButton" Style="{StaticResource IconButtonStyle}" Width="22" MinWidth="22" Padding="0" Margin="-4,0,0,0"
                                        Click="MicDevice_Click" ToolTipService.ToolTip="Choose microphone" AutomationProperties.Name="Choose microphone">
                                    <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                            <Button x:Name="SendButton" Style="{StaticResource SendFabStyle}" Width="40" Height="36" Visibility="Collapsed"
                                    ToolTipService.ToolTip="Send" AutomationProperties.Name="Send" Click="Send_Click" />
                        </Grid>
                    </Grid>

                    <!-- Nothing selected -->
                    <StackPanel Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                Visibility="{x:Bind helpers:Ui.Collapsed(ViewModel.HasSelection), Mode=OneWay}">
                        <Image Source="ms-appx:///Assets/AppIcon.png" Width="72" />
                        <TextBlock Text="WAFluent" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Pick a chat to start messaging." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- ───── Send preview (MainWindow.Attach.cs): WhatsApp Web's, over the conversation ───── -->
                    <Grid x:Name="MediaComposer" Grid.RowSpan="4" Visibility="Collapsed" Background="{ThemeResource ChatPaneBackgroundBrush}"
                          KeyboardAcceleratorPlacementMode="Hidden">
                        <Grid.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape" Invoked="MediaComposerEscape_Invoked" />
                        </Grid.KeyboardAccelerators>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Style="{StaticResource IconButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Close (Esc)" AutomationProperties.Name="Close" Click="MediaComposerClose_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="16" />
                        </Button>
                        <!-- HD or standard quality for the photos and videos (HD only when one is bigger than standard). -->
                        <Button x:Name="HdButton" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Padding="10,3,10,4"
                                CornerRadius="6" BorderThickness="1.5" Click="HdToggle_Click" AutomationProperties.Name="HD quality">
                            <TextBlock x:Name="HdLabel" Text="HD" FontSize="13" FontWeight="Bold" />
                        </Button>
                        <TextBlock x:Name="MediaComposerTitle" Margin="90,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="15" TextTrimming="CharacterEllipsis" />
                        <!-- The selected file, big: picture, video/audio player, or a card when there's nothing to show. -->
                        <Grid x:Name="MediaComposerStage" Grid.Row="1" Margin="40,8,40,8" />
                        <Border Grid.Row="2" MaxWidth="780" Margin="40,4,40,18" CornerRadius="8"
                                Background="{ThemeResource ComposerFieldBrush}">
                            <Grid ColumnSpacing="4" Padding="4,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MediaCaptionBox" PlaceholderText="Type a message" TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxHeight="120" BorderThickness="0" Background="Transparent" Padding="8,10,8,10"
                                         TextChanged="MediaCaption_TextChanged" PreviewKeyDown="MediaCaption_PreviewKeyDown">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    </TextBox.Resources>
                                </TextBox>
                                <Button x:Name="MediaCaptionEmoji" Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Emoji" AutomationProperties.Name="Emoji" Click="MediaCaptionEmoji_Click">
                                    <FontIcon Glyph="&#xE76E;" FontSize="17" />
                                </Button>
                            </Grid>
                        </Border>
                        <!-- Thumbnails (click to show one, ✕ to drop it), + to add more, and Send. -->
                        <Grid Grid.Row="3" Height="96" BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="0,1,0,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled"
                                          VerticalScrollMode="Disabled" HorizontalAlignment="Center" Margin="90,0">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <StackPanel x:Name="MediaComposerStrip" Orientation="Horizontal" Spacing="10" />
                                    <Button Width="60" Height="60" Padding="0" CornerRadius="6" Background="Transparent"
                                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1"
                                            ToolTipService.ToolTip="Add file" AutomationProperties.Name="Add file" Click="MediaComposerAdd_Click">
                                        <FontIcon Glyph="&#xE710;" FontSize="18" />
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                            <Button Style="{StaticResource SendFabStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0"
                                    ToolTipService.ToolTip="Send" AutomationProperties.Name="Send" Click="MediaComposerSend_Click" />
                        </Grid>
                    </Grid>

                    <!-- ───── An album's photos and videos, all of them (MainWindow.Album.cs) ───── -->
                    <Grid x:Name="AlbumView" Grid.RowSpan="4" Visibility="Collapsed" Background="{ThemeResource ChatPaneBackgroundBrush}"
                          KeyboardAcceleratorPlacementMode="Hidden">
                        <Grid.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape" Invoked="AlbumViewEscape_Invoked" />
                        </Grid.KeyboardAccelerators>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="12,0,0,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" Click="AlbumViewClose_Click" ToolTipService.ToolTip="Close (Esc)"
                                    AutomationProperties.Name="Close">
                                <FontIcon Glyph="&#xE711;" FontSize="16" />
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AlbumViewTitle" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="AlbumViewSubtitle" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" Padding="16,4,16,16">
                            <VariableSizedWrapGrid x:Name="AlbumViewGrid" Orientation="Horizontal" ItemWidth="190" ItemHeight="190"
                                                   HorizontalAlignment="Center" />
                        </ScrollViewer>
                    </Grid>

                    <!-- ───── Send contacts and Create poll: cards over a dimmed conversation ───── -->
                    <Grid x:Name="AttachSheet" Grid.RowSpan="4" Visibility="Collapsed" Background="#66000000" Tapped="AttachSheet_Tapped"
                          KeyboardAcceleratorPlacementMode="Hidden">
                        <Grid.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Escape" Invoked="AttachSheetEscape_Invoked" />
                        </Grid.KeyboardAccelerators>

                        <!-- Send contacts; also Forward message to (MainWindow.MessageMenu.cs) -->
                        <Grid x:Name="ContactsCard" Width="440" MaxHeight="680" Margin="24" VerticalAlignment="Center" CornerRadius="8"
                              Background="{ThemeResource SheetBackgroundBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1"
                              Tapped="Card_Tapped" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="8,0,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}" Click="AttachSheetClose_Click" ToolTipService.ToolTip="Close (Esc)"
                                        AutomationProperties.Name="Close">
                                    <FontIcon Glyph="&#xE711;" FontSize="15" />
                                </Button>
                                <TextBlock x:Name="ContactsTitle" Text="Send contacts" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox x:Name="ContactSearch" Grid.Row="1" Margin="16,4,16,8" PlaceholderText="Search name or number" CornerRadius="20"
                                     Padding="38,8,12,8" TextChanged="ContactSearch_TextChanged" />
                            <FontIcon Grid.Row="1" Glyph="&#xE721;" FontSize="14" HorizontalAlignment="Left" Margin="30,0,0,4"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
                            <ListView x:Name="ContactList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ContactList_ItemClick"
>
                                <ListView.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate x:DataType="models:ContactGroup">
                                                <TextBlock Text="{x:Bind Key}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListView.GroupStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ContactRow">
                                        <Grid Height="64" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind Picked, Mode=TwoWay}" MinWidth="0" IsHitTestVisible="False" VerticalAlignment="Center" />
                                            <controls:Redact Grid.Column="1" VeilRadius="22" VerticalAlignment="Center">
                                                <controls:Avatar DisplayName="{x:Bind Name}" Source="{x:Bind AvatarPath}" Size="44" />
                                            </controls:Redact>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                <controls:Redact HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                </controls:Redact>
                                                <TextBlock Text="{x:Bind Subtitle}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasSubtitle}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Grid Grid.Row="3" Height="72" Padding="20,0,12,0" Background="{ThemeResource SheetFooterBrush}" CornerRadius="0,0,8,8">
                                <TextBlock x:Name="ContactsPicked" VerticalAlignment="Center" Margin="0,0,80,0" TextTrimming="CharacterEllipsis" FontSize="15" />
                                <Button x:Name="ContactsSend" Style="{StaticResource SendFabStyle}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" IsEnabled="False"
                                        ToolTipService.ToolTip="Send" AutomationProperties.Name="Send contacts" Click="ContactsSend_Click" />
                            </Grid>
                        </Grid>

                        <!-- Create poll -->
                        <Grid x:Name="PollCard" Width="440" MaxHeight="760" Margin="24" VerticalAlignment="Center" CornerRadius="8"
                              Background="{ThemeResource SheetBackgroundBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1"
                              Tapped="Card_Tapped" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="8,0,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}" Click="AttachSheetClose_Click" ToolTipService.ToolTip="Close (Esc)"
                                        AutomationProperties.Name="Close">
                                    <FontIcon Glyph="&#xE711;" FontSize="15" />
                                </Button>
                                <TextBlock Text="Create poll" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Padding="24,4,24,8">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Question" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PollQuestion" Style="{StaticResource UnderlineTextBoxStyle}" PlaceholderText="Ask question"
                                                 MaxLength="255" TextWrapping="Wrap" TextChanged="PollInput_Changed" />
                                        <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind PollQuestion}"
                                                Click="PollEmoji_Click" ToolTipService.ToolTip="Emoji" AutomationProperties.Name="Emoji">
                                            <FontIcon Glyph="&#xE76E;" FontSize="17" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Options" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0" />
                                    <!-- Drag an option by its handle to reorder; a new box appears as the last one fills. -->
                                    <ListView x:Name="PollOptionsList" SelectionMode="None" CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                                              ItemsSource="{x:Bind PollOptions}" Padding="0" Margin="-12,0,-12,0">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                                <Setter Property="Padding" Value="12,0,12,0" />
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:PollOptionDraft">
                                                <Grid ColumnSpacing="4" Margin="0,4,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Style="{StaticResource UnderlineTextBoxStyle}" PlaceholderText="Add text" MaxLength="100"
                                                             Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="PollInput_Changed" LostFocus="PollOption_LostFocus" />
                                                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="PollEmoji_Click"
                                                            ToolTipService.ToolTip="Emoji" AutomationProperties.Name="Emoji">
                                                        <FontIcon Glyph="&#xE76E;" FontSize="17" />
                                                    </Button>
                                                    <FontIcon Grid.Column="2" Glyph="&#xE700;" FontSize="14" Width="28"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              ToolTipService.ToolTip="Drag to reorder" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Grid Margin="0,20,0,0">
                                        <TextBlock Text="Allow multiple answers" FontSize="15" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="PollMultiple" IsOn="True" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Hide voter names" FontSize="15" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="PollHideVoters" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Set end time" FontSize="15" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="PollEnds" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right"
                                                      Toggled="PollEnds_Toggled" />
                                    </Grid>
                                    <!-- Date, then time, each full width: side by side the time's AM/PM didn't fit. -->
                                    <StackPanel x:Name="PollEndRow" Spacing="8" Visibility="Collapsed">
                                        <CalendarDatePicker x:Name="PollEndDate" HorizontalAlignment="Stretch" DateFormat="{}{day.integer} {month.full} {year.full}" />
                                        <TimePicker x:Name="PollEndTime" HorizontalAlignment="Stretch" MinWidth="0" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <Button x:Name="PollSend" Grid.Row="2" Style="{StaticResource SendFabStyle}" HorizontalAlignment="Right" Margin="0,4,20,20"
                                    IsEnabled="False" ToolTipService.ToolTip="Send" AutomationProperties.Name="Send poll" Click="PollSend_Click" />
                        </Grid>
                    </Grid>
                    <!-- Files dragged over the conversation (MainWindow.Drop.cs): drop to open the send preview. -->
                    <Grid x:Name="DropOverlay" Grid.RowSpan="4" Visibility="Collapsed" IsHitTestVisible="False" Padding="16">
                        <Rectangle Fill="{ThemeResource ChatPaneBackgroundBrush}" Opacity="0.92" Margin="-16" />
                        <Rectangle RadiusX="16" RadiusY="16" StrokeThickness="2" StrokeDashArray="5,4"
                                   Stroke="{ThemeResource ChatAccentBrush}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                <Ellipse Fill="{ThemeResource ChatAccentBrush}" />
                                <FontIcon Glyph="&#xE898;" FontSize="26" Foreground="White" />
                            </Grid>
                            <TextBlock x:Name="DropTitle" Text="Drop files here" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DropDetail" FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ───────────── Contact / group info, and New contact (MainWindow.ContactInfo.cs) ───────────── -->
                <Grid x:Name="InfoPanel" Grid.Column="2" Width="380" Visibility="Collapsed"
                      Background="{ThemeResource ChatHeaderBackgroundBrush}"
                      BorderBrush="{ThemeResource PaneDividerBrush}" BorderThickness="1,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="10,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="Close" Click="InfoClose_Click">
                            <FontIcon x:Name="InfoCloseIcon" Glyph="&#xE711;" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="InfoTitle" Text="Contact info" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Contact info -->
                    <ScrollViewer x:Name="ContactInfoView" Grid.Row="1">
                        <StackPanel Padding="16,8,16,24">
                            <controls:Redact VeilRadius="80" HorizontalAlignment="Center">
                                <controls:Avatar DisplayName="{x:Bind ViewModel.SelectedChat.Name, Mode=OneWay}"
                                                 Source="{x:Bind ViewModel.SelectedChat.AvatarPath, Mode=OneWay}" Size="160"
                                                 IsGroup="{x:Bind ViewModel.SelectedChat.IsGroup, Mode=OneWay, FallbackValue=False}" />
                            </controls:Redact>
                            <controls:Redact HorizontalAlignment="Center" Margin="0,16,0,0">
                                <TextBlock Text="{x:Bind ViewModel.SelectedChat.Name, Mode=OneWay}" FontSize="24" TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </controls:Redact>
                            <controls:Redact HorizontalAlignment="Center" Margin="0,4,0,0"
                                             Visibility="{x:Bind helpers:Ui.NotEmpty(ViewModel.SelectedChat.PushNameLine), Mode=OneWay, FallbackValue=Collapsed}">
                                <TextBlock Text="{x:Bind ViewModel.SelectedChat.PushNameLine, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </controls:Redact>
                            <StackPanel x:Name="InfoActions" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,18,0,8" />
                            <StackPanel x:Name="InfoRows" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Message info (MainWindow.MessageInfo.cs) -->
                    <ScrollViewer x:Name="MessageInfoView" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel x:Name="MessageInfoRows" Padding="0,0,0,16" />
                    </ScrollViewer>

                    <!-- This chat's starred messages (MainWindow.ChatStarred.cs) -->
                    <Grid x:Name="ChatStarredView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="ChatStarredSearch" Margin="16,4,16,8" PlaceholderText="Search" CornerRadius="20"
                                 Padding="38,8,12,8" TextChanged="ChatStarredSearch_TextChanged" />
                        <FontIcon Glyph="&#xE721;" FontSize="14" HorizontalAlignment="Left" Margin="30,0,0,4"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
                        <ScrollViewer Grid.Row="1">
                            <StackPanel x:Name="ChatStarredRows" Padding="4,0,4,16" />
                        </ScrollViewer>
                        <StackPanel x:Name="ChatStarredEmpty" Grid.Row="1" Spacing="12" VerticalAlignment="Center" Margin="24,0,24,60"
                                    Visibility="Collapsed">
                            <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                <Ellipse Fill="{ThemeResource ChatAccentBrush}" />
                                <FontIcon Glyph="&#xE735;" FontSize="32" Foreground="White" />
                            </Grid>
                            <TextBlock Text="No starred messages" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Star messages in this chat to find them here." TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Disappearing messages (MainWindow.Disappearing.cs) -->
                    <ScrollViewer x:Name="DisappearingView" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel Padding="24,12,24,24" Spacing="14">
                            <Grid Width="120" Height="120" HorizontalAlignment="Center" Margin="0,8,0,8">
                                <Ellipse Fill="{ThemeResource ChatAccentBrush}" />
                                <FontIcon Glyph="&#xE916;" FontSize="54" Foreground="White" />
                            </Grid>
                            <TextBlock Text="Make messages in this chat disappear" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="For more privacy and storage, all new messages will disappear from this chat for everyone after the selected duration. Anyone in the chat can change this setting." />
                            <RadioButtons x:Name="DisappearingChoices" SelectionChanged="DisappearingChoices_SelectionChanged" Margin="0,4,0,0">
                                <x:String>Off</x:String>
                                <x:String>24 hours</x:String>
                                <x:String>7 days</x:String>
                                <x:String>90 days</x:String>
                            </RadioButtons>
                            <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Messages already in the chat stay. Starred messages are kept on this PC." />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Media, links and docs (MainWindow.Gallery.cs) -->
                    <Grid x:Name="GalleryView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <SelectorBar x:Name="GalleryTabs" Margin="8,0,8,4" SelectionChanged="GalleryTabs_SelectionChanged">
                            <SelectorBarItem Text="Media" IsSelected="True" />
                            <SelectorBarItem Text="Docs" />
                            <SelectorBarItem Text="Links" />
                        </SelectorBar>
                        <ScrollViewer x:Name="GalleryScroll" Grid.Row="1">
                            <StackPanel x:Name="GalleryContent" Padding="12,4,12,16" />
                        </ScrollViewer>
                        <ProgressRing x:Name="GalleryLoading" Grid.Row="1" Width="32" Height="32" IsActive="False" />
                    </Grid>

                    <!-- Search messages (MainWindow.Search.cs) -->
                    <Grid x:Name="SearchView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="10,4,14,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SearchDateButton" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Go to date" AutomationProperties.Name="Go to date">
                                <FontIcon Glyph="&#xE787;" FontSize="17" />
                                <Button.Flyout>
                                    <Flyout x:Name="SearchDateFlyout" Placement="BottomEdgeAlignedLeft">
                                        <CalendarView x:Name="SearchCalendar" SelectionMode="Single" SelectedDatesChanged="SearchCalendar_SelectedDatesChanged" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBox x:Name="MessageSearchBox" Grid.Column="1" PlaceholderText="Search" CornerRadius="20" Padding="38,8,12,8"
                                     TextChanged="MessageSearchBox_TextChanged" />
                            <FontIcon Grid.Column="1" Glyph="&#xE721;" FontSize="14" HorizontalAlignment="Left" Margin="14,0,0,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
                        </Grid>
                        <ScrollViewer Grid.Row="1">
                            <StackPanel>
                                <TextBlock x:Name="SearchHint" Margin="24,24,24,12" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ProgressRing x:Name="SearchRing" Width="24" Height="24" IsActive="False" Margin="0,12,0,0" />
                                <ListView x:Name="SearchResultsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="SearchResult_ItemClick"
                                          ScrollViewer.VerticalScrollMode="Disabled" />
                                <Rectangle x:Name="SearchFooterLine" Height="1" Margin="0,4,0,0" Fill="{ThemeResource PaneDividerBrush}" Visibility="Collapsed" />
                                <TextBlock x:Name="SearchFooter" Margin="24,16,24,24" TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- New contact -->
                    <Grid x:Name="NewContactView" Grid.Row="1" Visibility="Collapsed" Padding="16,8,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer>
                            <Grid ColumnSpacing="16" RowSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <FontIcon Glyph="&#xE77B;" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="FirstNameBox" Grid.Column="1" Header="First name" TextChanged="ContactName_TextChanged" />
                                <TextBox x:Name="LastNameBox" Grid.Row="1" Grid.Column="1" Header="Last name" />

                                <FontIcon Grid.Row="2" Glyph="&#xE717;" FontSize="18" VerticalAlignment="Top" Margin="0,34,0,0"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The chat's own number: its country is fixed. -->
                                        <ComboBox x:Name="CountryBox" Header="Country" HorizontalAlignment="Stretch" IsEnabled="False" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="PhoneBox" Header="Phone" IsReadOnly="True" />
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,10,9" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </Grid>
                                    <TextBlock Text="This phone number is on WhatsApp." FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <FontIcon Grid.Row="3" Glyph="&#xE895;" FontSize="18" VerticalAlignment="Top" Margin="0,4,0,0"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Sync contact to phone" />
                                        <TextBlock Text="This contact will be added to your phone's address book." FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SyncToPhoneSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                                  VerticalAlignment="Center" AutomationProperties.Name="Sync contact to phone" />
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                        <Button x:Name="SaveContactButton" Grid.Row="1" Content="Save" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Height="40" IsEnabled="False" Click="SaveContact_Click" />
                    </Grid>
                </Grid>

                <!-- Drag the edge to resize the chat list, past the minimum to close it; double-click toggles. -->
                <controls:PaneSplitter x:Name="ChatListSplitter" Grid.Column="1" Width="10" Margin="-5,0,0,0"
                                       HorizontalAlignment="Left" />
            </Grid>
        </NavigationView>

        <!-- ═════════════ Link your phone (live mode, until chats are available) ═════════════ -->
        <Grid Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              Visibility="{x:Bind ViewModel.ShowLinkScreen, Mode=OneWay}">
            <Border MaxWidth="920" Margin="32" Padding="40,36" VerticalAlignment="Center" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="22" VerticalAlignment="Center">
                        <TextBlock Text="Use WhatsApp on your computer" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">Open <Bold>WhatsApp</Bold> on your phone</TextBlock>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">Tap <Bold>Menu ⋮</Bold> on Android, or <Bold>Settings</Bold> on iPhone</TextBlock>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">Tap <Bold>Linked devices</Bold>, then <Bold>Link a device</Bold></TextBlock>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">Point your phone at this screen to scan the QR code</TextBlock>
                            </Grid>
                        </StackPanel>
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Unofficial client"
                                 Message="WAFluent isn't made by WhatsApp. Meta can suspend accounts that use unofficial apps, so a spare number is safest for now." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Width="280" Spacing="16" VerticalAlignment="Center">
                        <!-- Always black on white so it scans in dark mode too. -->
                        <Border Width="264" Height="264" Padding="6" CornerRadius="8" Background="White" HorizontalAlignment="Center">
                            <Grid>
                                <Image Source="{x:Bind ViewModel.QrImage, Mode=OneWay}" Stretch="Uniform"
                                       Visibility="{x:Bind ViewModel.ShowQr, Mode=OneWay}"
                                       AutomationProperties.Name="Pairing QR code" />
                                <ProgressRing Width="44" Height="44" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                              IsActive="{x:Bind ViewModel.ShowLinkProgress, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.ShowLinkProgress, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.LinkStatusText, Mode=OneWay}" TextWrapping="Wrap"
                                   HorizontalTextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═════════════ Video viewer (MainWindow.Video.cs) ═════════════
             A lightbox like the photos': the video at its own shape, a click outside closes it.
             Controls: play on the left, seek, volume always shown on the right. GIFs loop, muted. -->
        <Grid x:Name="VideoViewer" Grid.Row="1" Visibility="Collapsed" Background="Transparent"
              KeyboardAcceleratorPlacementMode="Hidden" Tapped="VideoViewer_Tapped" SizeChanged="VideoViewer_SizeChanged">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="VideoClose_Invoked" />
                <KeyboardAccelerator Key="Space" Invoked="VideoPlayPause_Invoked" />
                <KeyboardAccelerator Key="F" Invoked="VideoFullScreen_Invoked" />
            </Grid.KeyboardAccelerators>
            <Border x:Name="VideoScrim" Opacity="0" Background="{ThemeResource LightboxBackgroundBrush}">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.22" />
                </Border.OpacityTransition>
            </Border>
            <Grid x:Name="VideoFrame" HorizontalAlignment="Center" VerticalAlignment="Center" Tapped="VideoFrame_Tapped"
                  DoubleTapped="VideoFrame_DoubleTapped">
                <MediaPlayerElement x:Name="VideoPlayer" AreTransportControlsEnabled="False" AutoPlay="True" Stretch="Uniform"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Grid x:Name="VideoBar" VerticalAlignment="Bottom" Margin="12" Padding="14,4,14,8" CornerRadius="8" RowSpacing="0"
                      Background="{ThemeResource LightboxBarBrush}" Tapped="VideoBar_Tapped">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Slider x:Name="VideoSeek" Minimum="0" Maximum="1" StepFrequency="0.01" IsThumbToolTipEnabled="False"
                            ValueChanged="VideoSeek_ValueChanged" AutomationProperties.Name="Seek" />
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="VideoPlayButton" Style="{StaticResource IconButtonStyle}" Click="VideoPlay_Click"
                                ToolTipService.ToolTip="Play/Pause (Space)" AutomationProperties.Name="Play or pause">
                            <FontIcon x:Name="VideoPlayIcon" Glyph="&#xE769;" FontSize="16" />
                        </Button>
                        <TextBlock x:Name="VideoTime" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0:00 / 0:00" />
                        <Button x:Name="VideoMuteButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="VideoMute_Click"
                                ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute">
                            <FontIcon x:Name="VideoVolumeIcon" Glyph="&#xE767;" FontSize="16" />
                        </Button>
                        <Slider x:Name="VideoVolume" Grid.Column="3" Width="96" Minimum="0" Maximum="100" Value="100"
                                VerticalAlignment="Center" IsThumbToolTipEnabled="False" ValueChanged="VideoVolume_ValueChanged"
                                AutomationProperties.Name="Volume" />
                        <Button x:Name="VideoFullScreenButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0"
                                Click="VideoFullScreen_Click" ToolTipService.ToolTip="Full screen (F)" AutomationProperties.Name="Full screen">
                            <FontIcon x:Name="VideoFullScreenIcon" Glyph="&#xE740;" FontSize="15" />
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
            <Button x:Name="VideoCloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Style="{StaticResource IconButtonStyle}"
                    Click="VideoClose_Click" ToolTipService.ToolTip="Close (Esc)" AutomationProperties.Name="Close video">
                <FontIcon Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- ═════════════ Photo viewer (lightbox) ═════════════
             Opens with a Quick Look-style zoom: FlyImage springs from the thumbnail to the
             centre while the scrim dims and the arrows/caption fade in; nothing sits over the photo. -->
        <Grid x:Name="Lightbox" Grid.Row="1" Visibility="Collapsed" Background="Transparent"
              KeyboardAcceleratorPlacementMode="Hidden"
              Tapped="Lightbox_BackgroundTapped">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="LightboxClose_Invoked" />
                <KeyboardAccelerator Key="Left" Invoked="LightboxPrev_Invoked" />
                <KeyboardAccelerator Key="Right" Invoked="LightboxNext_Invoked" />
            </Grid.KeyboardAccelerators>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="LightboxScrim" Grid.RowSpan="2" Opacity="0" Background="{ThemeResource LightboxBackgroundBrush}">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.22" />
                </Border.OpacityTransition>
            </Border>

            <!-- The photo: Ctrl+wheel / pinch / double-click to zoom, drag to pan when zoomed. -->
            <ScrollViewer x:Name="LightboxScroller" Grid.Row="0"
                          ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="8"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          SizeChanged="LightboxScroller_SizeChanged">
                <Image x:Name="LightboxImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                       DoubleTapped="LightboxImage_DoubleTapped" Tapped="LightboxEat_Tapped"
                       AutomationProperties.Name="Photo">
                    <!-- Right-click actions; shortcuts are handled in MainWindow.Lightbox.cs. -->
                    <Image.ContextFlyout>
                        <MenuFlyout Opening="LightboxMenu_Opening">
                            <MenuFlyoutItem x:Name="LightboxZoomInItem" Text="Zoom in" KeyboardAcceleratorTextOverride="Ctrl++"
                                            Click="LightboxZoomIn_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A3;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="LightboxZoomOutItem" Text="Zoom out" KeyboardAcceleratorTextOverride="Ctrl+−"
                                            Click="LightboxZoomOut_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE71F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Copy" KeyboardAcceleratorTextOverride="Ctrl+C" Click="LightboxCopy_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Save as…" KeyboardAcceleratorTextOverride="Ctrl+S" Click="LightboxSave_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Open in Photos" Click="LightboxOpen_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Image.ContextFlyout>
                </Image>
            </ScrollViewer>

            <!-- Previous / next photo in this chat -->
            <Button x:Name="LightboxPrev" Grid.Row="0" HorizontalAlignment="Left" Margin="16,0" Width="44" Height="44"
                    CornerRadius="22" Background="{ThemeResource LightboxBarBrush}" BorderThickness="0" Opacity="0"
                    AutomationProperties.Name="Previous photo" Click="LightboxPrev_Click" Tapped="LightboxEat_Tapped">
                <Button.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </Button.OpacityTransition>
                <FontIcon Glyph="&#xE76B;" FontSize="16" />
            </Button>
            <Button x:Name="LightboxNext" Grid.Row="0" HorizontalAlignment="Right" Margin="16,0" Width="44" Height="44"
                    CornerRadius="22" Background="{ThemeResource LightboxBarBrush}" BorderThickness="0" Opacity="0"
                    AutomationProperties.Name="Next photo" Click="LightboxNext_Click" Tapped="LightboxEat_Tapped">
                <Button.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </Button.OpacityTransition>
                <FontIcon Glyph="&#xE76C;" FontSize="16" />
            </Button>

            <TextBlock x:Name="LightboxCaption" Grid.Row="1" Margin="24,12,24,20" TextWrapping="Wrap" Opacity="0"
                       HorizontalAlignment="Center" HorizontalTextAlignment="Center" MaxWidth="720"
                       IsTextSelectionEnabled="True" Tapped="LightboxEat_Tapped">
                <TextBlock.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </TextBlock.OpacityTransition>
            </TextBlock>

            <!-- "Copied" / "Saved": fades in near the bottom, then away. -->
            <Border x:Name="LightboxToast" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                    Padding="14,6" CornerRadius="16" Background="{ThemeResource LightboxBarBrush}" Opacity="0" IsHitTestVisible="False">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </Border.OpacityTransition>
                <TextBlock x:Name="LightboxToastText" FontSize="13" />
            </Border>

            <!-- The picture in flight between its bubble and the viewer; above everything, never clipped. -->
            <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
                <Image x:Name="FlyImage" Stretch="Uniform" Visibility="Collapsed" />
            </Canvas>
        </Grid>


        <!-- Confirmations and errors ("Forwarded", "Couldn't block this chat"). -->
        <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,84"
                Padding="14,8" CornerRadius="8" Opacity="0" IsHitTestVisible="False" Translation="0,0,24"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Border.OpacityTransition>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="ToastIcon" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- A reaction flying from the menu to its pill (MainWindow.Reactions.cs). -->
        <Canvas x:Name="FxLayer" Grid.RowSpan="2" IsHitTestVisible="False" />
    </Grid>
</Window>
