<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WhatsAppNative</RootNamespace>
    <AssemblyName>WAFluent</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!--
    Builds the Rust WhatsApp connection (../core) and ships it next to the app as
    core\wafluent-core.exe. Pass -p:SkipCore=true to build the UI alone.
  -->
  <PropertyGroup>
    <CoreDir>$(MSBuildThisFileDirectory)..\core\</CoreDir>
    <CoreProfile Condition="'$(Configuration)' == 'Release'">release</CoreProfile>
    <CoreProfile Condition="'$(Configuration)' != 'Release'">debug</CoreProfile>
    <CoreCargoFlags Condition="'$(Configuration)' == 'Release'">--release</CoreCargoFlags>
    <!-- rustup's default location; PATH may not include it for MSBuild. -->
    <CargoExe>cargo</CargoExe>
    <CargoExe Condition="Exists('$(USERPROFILE)\.cargo\bin\cargo.exe')">"$(USERPROFILE)\.cargo\bin\cargo.exe"</CargoExe>
  </PropertyGroup>

  <!--
    Ship an already-built core even when SkipCore=true. Without this, MSBuild's incremental
    clean deletes core\wafluent-core.exe from the output as an orphan of earlier builds.
  -->
  <ItemGroup Condition="Exists('$(CoreDir)target\$(CoreProfile)\wafluent-core.exe')">
    <Content Include="$(CoreDir)target\$(CoreProfile)\wafluent-core.exe" Link="core\wafluent-core.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildCore" BeforeTargets="BeforeBuild" Condition="'$(SkipCore)' != 'true'">
    <Exec Command="$(CargoExe) build $(CoreCargoFlags) --manifest-path &quot;$(CoreDir)Cargo.toml&quot;" />
    <!-- First build ever: the exe didn't exist when the static item above was evaluated. -->
    <ItemGroup Condition="'@(Content-&gt;WithMetadataValue('Link', 'core\wafluent-core.exe'))' == ''">
      <Content Include="$(CoreDir)target\$(CoreProfile)\wafluent-core.exe" Link="core\wafluent-core.exe" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
